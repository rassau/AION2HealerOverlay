<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        x:Class="Cloris.Aion2Flow.Views.HiddenCubesWindow"
        x:DataType="vm:HiddenCubesViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Heal/Styles/OverlayTheme.axaml" />

        <!-- Like the group frame's: see-through while the game has focus, a panel to drag once the overlay has. -->
        <Style Selector="Border.CubeFrameRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Border.CubeFrameRoot.interactive">
            <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudBackdrop}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
        </Style>

        <Style Selector="TextBlock.CubeFrameTitle">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.CubeFrameRoot.interactive TextBlock.CubeFrameTitle">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The gear, the eye and the cross only while the overlay has focus, as the frame lets clicks through otherwise. -->
        <Style Selector="Border.CubeFrameRoot:not(.interactive) Button.CubeFrameChrome">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Border.CubeFrameTrack, Border.CubeFrameDistance">
            <Setter Property="Background" Value="#C0101418" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.CubeFrameDistance">
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <Style Selector="Border.CubeFrameDistance TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.CubeFrameName">
            <Setter Property="Foreground" Value="#E6C65A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Your own position is a few seconds old: where the cube is from you is a guess. -->
        <Style Selector="Panel.guessed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </Window.Styles>

    <Border x:Name="FrameRoot"
            Classes="CubeFrameRoot"
            PointerPressed="DragWindow">
        <StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,3">
                <TextBlock x:Name="FrameTitle" Classes="CubeFrameTitle" />
                <Button Grid.Column="1"
                        Classes="WindowBtn CubeFrameChrome FrameBody"
                        Click="SettingsClicked"
                        ToolTip.Tip="{markups:Translate HiddenCubes_Title}">
                    <Path Classes="Glyph GlyphMd" Data="{StaticResource settings}" />
                </Button>
                <Button Grid.Column="2"
                        Classes="WindowBtn CubeFrameChrome"
                        Click="EyeClicked"
                        ToolTip.Tip="{markups:Translate Frame_MinimizeTip}">
                    <Panel>
                        <Path Classes="Glyph GlyphMd FrameEyeOpen" Data="{StaticResource eye}" />
                        <Path Classes="Glyph GlyphMd FrameEyeShut" Data="{StaticResource eye-off}" />
                    </Panel>
                </Button>
                <Button Grid.Column="3"
                        Classes="WindowBtn CloseBtn CubeFrameChrome"
                        Click="CloseClicked"
                        ToolTip.Tip="{markups:Translate Frame_CloseTip}">
                    <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                </Button>
            </Grid>
            <!-- A line per cube, nearest first, with the way to it (see HiddenCubesViewModel). -->
            <ItemsControl Classes="FrameBody" ItemsSource="{Binding Cubes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupFrameMemberRow">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" Margin="0,0,0,3" HorizontalAlignment="Left">
                            <Panel Width="180" Height="24">
                                <Border Classes="CubeFrameTrack" />
                                <TextBlock Classes="CubeFrameName" Text="{Binding Name}" />
                            </Panel>
                            <Panel Grid.Column="1"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   MinWidth="48"
                                   Margin="3,0,0,0">
                                <Border Classes="CubeFrameDistance" IsVisible="{Binding HasArrow}">
                                    <TextBlock Text="{Binding DistanceText}" Foreground="{Binding DistanceBrush}" />
                                </Border>
                            </Panel>
                            <Panel Grid.Column="2"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   Width="28"
                                   Height="24"
                                   Margin="3,0,0,0"
                                   Background="Transparent"
                                   ToolTip.Tip="{markups:Translate GroupFrame_ArrowTip}">
                                <controls:Arrow3D IsVisible="{Binding HasArrow}"
                                                  Fill="{Binding ArrowBrush}"
                                                  Yaw="{Binding ArrowYaw}"
                                                  Pitch="{Binding ArrowPitch}" />
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</Window>
