<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        x:Class="Cloris.Aion2Flow.Views.GroupFrameWindow"
        x:DataType="vm:GroupFrameViewModel"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        CanMinimize="False"
        CanMaximize="False"
        ShowActivated="False"
        ShowInTaskbar="False"
        Topmost="False">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Heal/Styles/OverlayTheme.axaml" />

        <Style Selector="Border.GroupFrameRoot">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.interactive">
            <Setter Property="Background" Value="{StaticResource OverlayBrush.MainHudBackdrop}" />
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.Border}" />
        </Style>

        <Style Selector="TextBlock.GroupFrameTitle">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,3" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.interactive TextBlock.GroupFrameTitle">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Like the title: only while the overlay has focus, as the frame lets clicks through to the game otherwise. -->
        <Style Selector="Border.GroupFrameRoot:not(.interactive) Button.GroupFrameSettings">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="Border.GroupFrameHpTrack">
            <Setter Property="Background" Value="#C0101418" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="controls|SlantedProgressBar.GroupFrameHpBar">
            <Setter Property="SlantWidth" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="TextBlock.GroupFrameName">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style Selector="StackPanel.GroupFrameDeaths">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="2" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="StackPanel.GroupFrameDeaths TextBlock">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Path.GroupFrameGrave">
            <Setter Property="Fill" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="11" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Panel.dead Path.GroupFrameGrave">
            <Setter Property="Fill" Value="#F07C82" />
        </Style>

        <Style Selector="TextBlock.GroupFrameHp">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Like the HP panel, so the coloured number reads on any ground. -->
        <Style Selector="Border.GroupFrameDistance">
            <Setter Property="Background" Value="#C0101418" />
            <Setter Property="BorderBrush" Value="#50FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,0" />
        </Style>

        <Style Selector="Border.GroupFrameDistance TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Panel.far">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- On the bar's edge; a debuff's purple frame moves inside it then. -->
        <Style Selector="Border.GroupFrameAggroFrame">
            <Setter Property="BorderBrush" Value="#FF3B30" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="Panel.aggro Border.GroupFrameDebuffFrame">
            <Setter Property="Margin" Value="2" />
        </Style>

        <!-- In the title's line, which is always there, so nothing moves when it shows. -->
        <Style Selector="Border.GroupFrameAlert">
            <Setter Property="Background" Value="#E0C62828" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <Style Selector="Border.GroupFrameAlert TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Border.GroupFrameAlert.on">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="Infinite">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Opacity" Value="0.45" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.GroupFrameDebuffFrame">
            <Setter Property="BorderBrush" Value="#A855F7" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <Style Selector="controls|SegmentedBar.GroupFrameShieldBar">
            <Setter Property="Margin" Value="1" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <Style Selector="TextBlock.GroupFrameShield">
            <Setter Property="Foreground" Value="#8CD8FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Panel.dead TextBlock">
            <Setter Property="Foreground" Value="#F07C82" />
        </Style>

        <Style Selector="Border.GroupFrameAuraBack">
            <Setter Property="Background" Value="#D0161B20" />
        </Style>

        <Style Selector="Panel.debuff Border.GroupFrameAuraBack">
            <Setter Property="Background" Value="#D05A1A1E" />
        </Style>

        <Style Selector="Border.GroupFrameAuraFrame">
            <Setter Property="BorderBrush" Value="{StaticResource OverlayBrush.MainHudGold}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Panel.debuff Border.GroupFrameAuraFrame">
            <Setter Property="BorderBrush" Value="#F07C82" />
        </Style>

        <Style Selector="Panel.other Border.GroupFrameAuraFrame">
            <Setter Property="BorderBrush" Value="#8FB8E8" />
        </Style>

        <Style Selector="TextBlock.GroupFrameAuraFallback">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style Selector="TextBlock.GroupFrameAuraTime">
            <Setter Property="Foreground" Value="{StaticResource OverlayBrush.Text}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Margin" Value="0,0,2,0" />
        </Style>

        <!-- A member's row: the HP bar in the middle column, then outwards the distance, the arrow and the auras, each right
             of the bar, mirrored to its left or off, as the settings say (classes from GroupFrameWindow.ApplySides). -->
        <Style Selector="Panel.GroupFrameDistanceSlot">
            <Setter Property="Grid.Column" Value="4" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style Selector="Panel.GroupFrameArrowSlot">
            <Setter Property="Grid.Column" Value="5" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style Selector="ReversibleStackPanel.GroupFrameAuras">
            <Setter Property="Grid.Column" Value="6" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.distanceLeft Panel.GroupFrameDistanceSlot">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.arrowLeft Panel.GroupFrameArrowSlot">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.aurasLeft ReversibleStackPanel.GroupFrameAuras">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="ReverseOrder" Value="True" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.aurasLeft ReversibleStackPanel.GroupFrameAuraIcons">
            <Setter Property="ReverseOrder" Value="True" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.distanceOff Panel.GroupFrameDistanceSlot, Border.GroupFrameRoot.arrowOff Panel.GroupFrameArrowSlot, Border.GroupFrameRoot.aurasOff ReversibleStackPanel.GroupFrameAuras">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- A cube's distance and arrow, whatever the members' sides: right of its banner, on the side the rows grow to,
             so the banner stays in line with the bars; with the auras on the left the frame grows to the left, and they
             go left of it, mirrored. -->
        <Style Selector="Panel.GroupFrameCubeDistance">
            <Setter Property="Grid.Column" Value="4" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style Selector="Panel.GroupFrameCubeArrow">
            <Setter Property="Grid.Column" Value="5" />
            <Setter Property="Margin" Value="3,0,0,0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.aurasLeft Panel.GroupFrameCubeDistance">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <Style Selector="Border.GroupFrameRoot.aurasLeft Panel.GroupFrameCubeArrow">
            <Setter Property="Grid.Column" Value="1" />
            <Setter Property="Margin" Value="0,0,3,0" />
        </Style>

        <!-- Your own position is a few seconds old: where they are from you is a guess. -->
        <Style Selector="Panel.GroupFrameDistanceSlot.guessed, Panel.GroupFrameArrowSlot.guessed, Panel.GroupFrameCubeDistance.guessed, Panel.GroupFrameCubeArrow.guessed">
            <Setter Property="Opacity" Value="0.45" />
        </Style>

        <!-- Each row only as wide as what it holds: a Grid wider than its columns hands the rest out to its Auto columns,
             so rows with fewer auras would shift. -->
        <Style Selector="Grid.GroupFrameRow, Button.GroupFrameSettings">
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>

        <!-- With the auras on the left the frame grows to the left (see OnSizeChanged), so everything keeps to its right
             edge: the HP bars line up whatever number of auras each row has. -->
        <Style Selector="Border.GroupFrameRoot.aurasLeft Grid.GroupFrameRow, Border.GroupFrameRoot.aurasLeft TextBlock.GroupFrameTitle, Border.GroupFrameRoot.aurasLeft Border.GroupFrameAlert, Border.GroupFrameRoot.aurasLeft Button.GroupFrameSettings">
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </Window.Styles>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="GroupFrameAuraPanel">
            <ReversibleStackPanel Classes="GroupFrameAuraIcons" Orientation="Horizontal" Spacing="2" />
        </ItemsPanelTemplate>

        <DataTemplate x:Key="GroupFrameAuraTemplate" x:DataType="vm:GroupFrameAuraIcon">
            <Panel Width="24"
                   Height="24"
                   Classes.debuff="{Binding IsDebuff}"
                   Classes.other="{Binding IsOther}"
                   ToolTip.Placement="Top">
                <!-- The name; what the skill does, the caster's specializations and the levels its numbers span. -->
                <ToolTip.Tip>
                    <StackPanel MaxWidth="380" Spacing="4">
                        <TextBlock Text="{Binding ToolTip}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Effect}" TextWrapping="Wrap"
                                   IsVisible="{Binding Effect, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding Specializations}" TextWrapping="Wrap"
                                   IsVisible="{Binding Specializations, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding EffectNote}" Opacity="0.65" TextWrapping="Wrap"
                                   IsVisible="{Binding EffectNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </ToolTip.Tip>
                <Border Classes="GroupFrameAuraBack">
                    <TextBlock Classes="GroupFrameAuraFallback" Text="{Binding FallbackText}" />
                </Border>
                <controls:SkillIcon Margin="1"
                                    Stretch="UniformToFill"
                                    AssetName="{Binding IconAssetName}" />
                <Border Classes="GroupFrameAuraFrame" />
                <TextBlock Classes="GroupFrameAuraTime" Text="{Binding RemainingText}" />
            </Panel>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="FrameRoot"
            Classes="GroupFrameRoot"
            PointerPressed="DragWindow">
        <StackPanel>
            <Panel>
                <TextBlock x:Name="FrameTitle" Classes="GroupFrameTitle" />
                <Border Classes="GroupFrameAlert"
                        Classes.on="{Binding IsBossTargetingMe}"
                        IsVisible="{Binding IsBossTargetingMe}"
                        Height="{Binding #FrameTitle.Bounds.Height}">
                    <TextBlock x:Name="FrameAlert" VerticalAlignment="Center" />
                </Border>
            </Panel>
            <ItemsControl ItemsSource="{Binding Members}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupFrameMemberRow">
                        <!-- The HP bar in the middle column; outwards from it the distance, the arrow and the auras, on
                             the sides the settings say (see the GroupFrameDistanceSlot, GroupFrameArrowSlot and
                             GroupFrameAuras styles). -->
                        <Grid Classes="GroupFrameRow"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              Margin="0,0,0,3">
                            <Panel Grid.Column="3"
                                   Width="180"
                                   Height="24"
                                   ToolTip.Tip="{Binding HpToolTip}"
                                   ToolTip.Placement="Top"
                                   Classes.dead="{Binding IsDead}"
                                   Classes.far="{Binding IsOutOfRange}"
                                   Classes.aggro="{Binding IsBossTarget}">
                                <!-- The bar and all on it as see-through as the settings say; out of range dims it all
                                     further (far). -->
                                <Panel Opacity="{DynamicResource GroupFrameHpOpacity}">
                                    <Border Classes="GroupFrameHpTrack" />
                                    <controls:SlantedProgressBar Classes="GroupFrameHpBar" Segment="{Binding HpBar}" />
                                    <controls:SegmentedBar Classes="GroupFrameShieldBar" Segments="{Binding ShieldSegments}" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="6,0">
                                        <!-- The name, then a grave cross with their deaths in the current boss fight; the
                                             name gives way first when space runs out. -->
                                        <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Left">
                                            <TextBlock Classes="GroupFrameName" Text="{Binding Name}" />
                                            <StackPanel Grid.Column="1" Classes="GroupFrameDeaths" IsVisible="{Binding HasDeaths}">
                                                <Path Classes="GroupFrameGrave" Data="M 3,0 H 5 V 3 H 8 V 5 H 5 V 12 H 3 V 5 H 0 V 3 H 3 Z" />
                                                <TextBlock Text="{Binding Deaths}" />
                                            </StackPanel>
                                        </Grid>
                                        <ItemsControl Grid.Column="1"
                                                      Margin="6,0,0,0"
                                                      VerticalAlignment="Center"
                                                      ItemsSource="{Binding ShieldParts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ShieldTextPart">
                                                    <TextBlock Classes="GroupFrameShield" Text="{Binding Text}" Opacity="{Binding Opacity}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Grid.Column="2"
                                                   Classes="GroupFrameHp"
                                                   Text="{Binding HpText}" />
                                    </Grid>
                                    <Border Classes="GroupFrameDebuffFrame" IsVisible="{Binding HasDebuff}" />
                                    <Border Classes="GroupFrameAggroFrame" IsVisible="{Binding IsBossTarget}" />
                                </Panel>
                            </Panel>
                            <!-- How far: green, orange and red up to the marks in the settings, grey past the range. The
                                 slot stays when nothing's known, wide enough for "999 m", so the rows line up. -->
                            <Panel Classes="GroupFrameDistanceSlot"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   MinWidth="48">
                                <Border Classes="GroupFrameDistance"
                                        IsVisible="{Binding HasArrow}"
                                        Opacity="{DynamicResource GroupFrameDistanceOpacity}">
                                    <TextBlock Text="{Binding DistanceText}" Foreground="{Binding DistanceBrush}" />
                                </Border>
                            </Panel>
                            <!-- Where the member is from you, in 3D as seen facing the way you're heading, like a cube's; its
                                 slot stays too. -->
                            <Panel Classes="GroupFrameArrowSlot"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   Width="28"
                                   Height="24"
                                   Background="Transparent"
                                   ToolTip.Tip="{markups:Translate GroupFrame_ArrowTip}">
                                <controls:Arrow3D IsVisible="{Binding HasArrow}"
                                                  Opacity="{DynamicResource GroupFrameArrowOpacity}"
                                                  Fill="{Binding ArrowBrush}"
                                                  Yaw="{Binding ArrowYaw}"
                                                  Pitch="{Binding ArrowPitch}" />
                            </Panel>
                            <ReversibleStackPanel Classes="GroupFrameAuras"
                                                  Orientation="Horizontal"
                                                  Spacing="3"
                                                  Opacity="{DynamicResource GroupFrameAuraOpacity}">
                                <ItemsControl ItemsSource="{Binding Debuffs}"
                                              ItemsPanel="{StaticResource GroupFrameAuraPanel}"
                                              ItemTemplate="{StaticResource GroupFrameAuraTemplate}" />
                                <ItemsControl ItemsSource="{Binding MyAuras}"
                                              ItemsPanel="{StaticResource GroupFrameAuraPanel}"
                                              ItemTemplate="{StaticResource GroupFrameAuraTemplate}" />
                                <ItemsControl ItemsSource="{Binding OtherAuras}"
                                              ItemsPanel="{StaticResource GroupFrameAuraPanel}"
                                              ItemTemplate="{StaticResource GroupFrameAuraTemplate}" />
                            </ReversibleStackPanel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The cube finder (experimental): a line per Hidden Cube the server announced, with the way to it right of
                 the banner, whatever the members' sides say (see GroupFrameViewModel.UpdateCubes). -->
            <ItemsControl ItemsSource="{Binding Cubes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:GroupFrameMemberRow">
                        <Grid Classes="GroupFrameRow"
                              ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                              Margin="0,0,0,3">
                            <!-- Empty, where a member's distance and arrow are, so the banner lines up with their bars. -->
                            <Panel Classes="GroupFrameDistanceSlot" MinWidth="48" />
                            <Panel Classes="GroupFrameArrowSlot" Width="28" />
                            <Panel Grid.Column="3"
                                   Width="180"
                                   Height="24"
                                   Opacity="{DynamicResource GroupFrameHpOpacity}">
                                <Border Classes="GroupFrameHpTrack" />
                                <TextBlock Classes="GroupFrameName"
                                           Margin="6,0"
                                           Foreground="#E6C65A"
                                           Text="{Binding Name}" />
                            </Panel>
                            <Panel Classes="GroupFrameCubeDistance"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   MinWidth="48">
                                <Border Classes="GroupFrameDistance"
                                        IsVisible="{Binding HasArrow}"
                                        Opacity="{DynamicResource GroupFrameDistanceOpacity}">
                                    <TextBlock Text="{Binding DistanceText}" Foreground="{Binding DistanceBrush}" />
                                </Border>
                            </Panel>
                            <Panel Classes="GroupFrameCubeArrow"
                                   Classes.guessed="{Binding IsPlacementGuessed}"
                                   Width="28"
                                   Height="24"
                                   Background="Transparent"
                                   ToolTip.Tip="{markups:Translate GroupFrame_ArrowTip}">
                                <controls:Arrow3D IsVisible="{Binding HasArrow}"
                                                  Opacity="{DynamicResource GroupFrameArrowOpacity}"
                                                  Fill="{Binding ArrowBrush}"
                                                  Yaw="{Binding ArrowYaw}"
                                                  Pitch="{Binding ArrowPitch}" />
                            </Panel>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- The frame's tab of the settings, behind a gear like the meter's; its line always stays, so nothing moves
                 when it shows. -->
            <Button Classes="BottomBarButton GroupFrameSettings"
                    Click="SettingsClicked"
                    ToolTip.Tip="{markups:Translate Settings_GroupFrame}">
                <Path Classes="Glyph GlyphMd" Data="{StaticResource settings}" />
            </Button>
        </StackPanel>
    </Border>
</Window>
