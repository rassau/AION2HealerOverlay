<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:views="clr-namespace:Cloris.Aion2Flow.Views"
        x:Class="Cloris.Aion2Flow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Classes="OverlayWindow"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Width="300"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        ShowActivated="False"
        Title="Aion2Heal"
        Icon="/Assets/Images/Aion2Heal.png">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Heal/Styles/OverlayTheme.axaml" />
    </Window.Styles>

    <Window.Resources>
        <!-- Column headings over the main table and over each boss fight's rows: the shared size groups line them up with the
             values below. A click on one sorts every table by its column, the highest first; another click the other way
             round. The column the rows go by has the arrow, as in the fight graphs' runs tables. -->
        <DataTemplate x:Key="CombatantColumnHeaderTemplate" x:DataType="vm:MainViewModel">
            <Grid Margin="5,0,5,1"
                  IsVisible="{Binding SettingsFlyout.ShowColumnHeaders}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricRecoveryTime" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricKills" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricLastHits" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricCredited" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.DamagePerSecond}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamagePerSecondColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Dps}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.DamagePerSecond}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.TotalDamage}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamageColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Damage}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.TotalDamage}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.HealingPerSecond}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                        IsVisible="{Binding CombatantColumns.ShowHealingPerSecondColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Hps}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.HealingPerSecond}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.TotalHealing}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                        IsVisible="{Binding CombatantColumns.ShowHealingColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Healing}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.TotalHealing}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.DamageTaken}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamageTakenColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_DamageTaken}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.DamageTaken}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.UnhealedHealth}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                        IsVisible="{Binding CombatantColumns.ShowUnhealedHealthColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_UnhealedHealth}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.UnhealedHealth}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="7"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.RecoveryTime}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_RecoveryTimeTip}"
                        IsVisible="{Binding CombatantColumns.ShowRecoveryTimeColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_RecoveryTime}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.RecoveryTime}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="8"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Aggro}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                        IsVisible="{Binding CombatantColumns.ShowAggroColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Aggro}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Aggro}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="9"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Stagger}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                        IsVisible="{Binding CombatantColumns.ShowStaggerColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Stagger}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Stagger}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="10"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Kills}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_KillsTip}"
                        IsVisible="{Binding CombatantColumns.ShowKillsColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Kills}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Kills}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="11"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.LastHits}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_LastHitsTip}"
                        IsVisible="{Binding CombatantColumns.ShowLastHitsColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_LastHits}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.LastHits}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="12"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Credited}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_CreditedTip}"
                        IsVisible="{Binding CombatantColumns.ShowCreditedColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Credited}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Credited}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="13"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.BossShare}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                        IsVisible="{Binding CombatantColumns.ShowBossShareColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_BossShare}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.BossShare}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- A boss fight: a header that folds it, the DPS check, and the main table's columns over the fight. -->
        <DataTemplate x:Key="BossFightTemplate" x:DataType="vm:BossFightViewModel">
            <StackPanel Spacing="0">
                <Button Classes="BossSectionHeader"
                        Command="{Binding ToggleExpandedCommand}"
                        ToolTip.Tip="{markups:Translate BossSection_Toggle}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="6">
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-down}"
                              IsVisible="{Binding IsExpanded}" />
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-right}"
                              IsVisible="{Binding !IsExpanded}" />
                        <TextBlock Grid.Column="1"
                                   Classes="BossSectionTitle"
                                   Text="{Binding Title}" />
                        <TextBlock Grid.Column="2"
                                   Classes="BossSectionCheck"
                                   Text="{Binding DetailText}" />
                        <controls:DurationBlock Grid.Column="3"
                                                Classes="BossSectionMetric"
                                                Duration="{Binding Duration}"
                                                DisplayFormat="{Binding $parent[Window].DataContext.SettingsFlyout.EncounterTimeDisplayFormat}"
                                                VerticalAlignment="Center" />
                        <controls:NumericBlock Grid.Column="4"
                                               Classes="BossSectionMetric"
                                               Value="{Binding DamagePerSecond}"
                                               Suffix="/s"
                                               Formatter="N0"
                                               UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            Margin="24,0,5,2"
                            IsVisible="{Binding IsDpsCheckVisible}">
                    <TextBlock Classes="BossSectionCheck"
                               Text="{Binding DpsCheckText}" />
                    <TextBlock Classes="BossSectionCheck BossSectionGap"
                               Classes.behind="{Binding IsBehind}"
                               Text="{Binding DpsGapText}" />
                </StackPanel>

                <ContentControl Content="{Binding $parent[Window].DataContext}"
                                ContentTemplate="{StaticResource CombatantColumnHeaderTemplate}"
                                IsVisible="{Binding IsExpanded}" />

                <!-- The fight's players: no more rows than the main table shows (Settings → DPS meter → Visible rows), the
                     rest scrolled with the mouse wheel as there. A click selects the player's row of the main table
                     (MainViewModel.SelectCombatantRow), so these rows take no selection of their own. -->
                <controls:AnimatedItemsView ItemsSource="{Binding Rows}"
                                            IsVisible="{Binding IsExpanded}"
                                            IsSelectionEnabled="False"
                                            MaxVisibleItems="{Binding $parent[Window].DataContext.SettingsFlyout.MaxVisibleCombatantRows}"
                                            ItemHeight="22"
                                            ItemSpacing="2"
                                            MoveDuration="0:0:0.16"
                                            AddRemoveDuration="0:0:0.14"
                                            AddRemoveOffset="16">
                    <controls:AnimatedItemsView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CombatantRowViewModel">
                            <Border Classes="OverlayRowCard BossFightRowCard"
                                    Height="22"
                                    Tapped="CombatantRowTapped">
                            <Grid>
                                <controls:SlantedProgressBar Classes="CombatantRowBar"
                                                             Segment="{Binding BarSegment}"
                                                             IsHitTestVisible="False" />

                                <Border Classes="OverlayRowHover" IsHitTestVisible="False" />

                                <Grid Margin="5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricRecoveryTime" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricKills" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricLastHits" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricCredited" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PcDisplay Grid.Column="0"
                                                        Classes="BossSectionName"
                                                        IconSize="20"
                                                        IconSpacing="4"
                                                        EntityId="{Binding Id}"
                                                        VerticalAlignment="Stretch" />
                                    <controls:NumericBlock Grid.Column="1"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding DamagePerSecond}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                                                           IsVisible="{Binding Columns.ShowDamagePerSecondColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0"
                                                           Suffix="/s" />
                                    <controls:NumericBlock Grid.Column="2"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding Damage}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                                                           IsVisible="{Binding Columns.ShowDamageColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="3"
                                                           Classes="OverlayRowMetric OverlayRowHealing"
                                                           Value="{Binding HealingPerSecond}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                                                           IsVisible="{Binding Columns.ShowHealingPerSecondColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0"
                                                           Suffix="/s" />
                                    <controls:NumericBlock Grid.Column="4"
                                                           Classes="OverlayRowMetric OverlayRowHealing"
                                                           Value="{Binding Healing}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                                                           IsVisible="{Binding Columns.ShowHealingColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="5"
                                                           Classes="OverlayRowMetric OverlayRowDamageTaken"
                                                           Value="{Binding DamageTaken}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                                                           IsVisible="{Binding Columns.ShowDamageTakenColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="6"
                                                           Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                           Value="{Binding UnhealedHealthSeconds}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                                                           IsVisible="{Binding Columns.ShowUnhealedHealthColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="7"
                                                           Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                           Value="{Binding RecoveryTime}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_RecoveryTimeTip}"
                                                           IsVisible="{Binding Columns.ShowRecoveryTimeColumn}"
                                                           Formatter="{Binding RecoveryTime, Converter={x:Static controls:FightGraph.SecondsFormatter}}"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="8"
                                                           Classes="OverlayRowMetric OverlayRowAggro"
                                                           Value="{Binding AggroShare}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                                                           IsVisible="{Binding Columns.ShowAggroColumn}"
                                                           Formatter="P0"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="9"
                                                           Classes="OverlayRowMetric OverlayRowStagger"
                                                           Value="{Binding StaggerShare}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                                                           IsVisible="{Binding Columns.ShowStaggerColumn}"
                                                           Formatter="P0"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                    <controls:NumericBlock Grid.Column="10"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding Kills}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_KillsTip}"
                                                           IsVisible="{Binding Columns.ShowKillsColumn}"
                                                           Formatter="N0"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                    <controls:NumericBlock Grid.Column="11"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding LastHits}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_LastHitsTip}"
                                                           IsVisible="{Binding Columns.ShowLastHitsColumn}"
                                                           Formatter="N0"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                    <controls:NumericBlock Grid.Column="12"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding Credited}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_CreditedTip}"
                                                           IsVisible="{Binding Columns.ShowCreditedColumn}"
                                                           Formatter="N0"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="13"
                                                           Classes="CombatantBossShareValue"
                                                           Value="{Binding BossShareRatio}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                                                           IsVisible="{Binding Columns.ShowBossShareColumn}"
                                                           Formatter="P1"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </controls:AnimatedItemsView.ItemTemplate>
                </controls:AnimatedItemsView>

                <!-- The fight's Sum row, with "Add boss sum row" on and from two rows on: a thin line over it, the label
                     where the names stand and each column shown added up (the recovery time and the shares the group's).
                     No player: no bar, no icon, no details. -->
                <Border Classes="BossFightSum"
                        IsVisible="{Binding IsSumVisible}"
                        ToolTip.Tip="{markups:Translate BossFight_SumTip}">
                    <Grid Height="22"
                          Margin="5,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricRecoveryTime" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricKills" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricLastHits" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricCredited" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Classes="BossFightSumLabel"
                                   Text="{markups:Translate BossFight_Sum}" />
                        <controls:NumericBlock Grid.Column="1"
                                               Classes="OverlayRowMetric"
                                               Value="{Binding Sum.DamagePerSecond}"
                                               IsVisible="{Binding Sum.Columns.ShowDamagePerSecondColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0"
                                               Suffix="/s" />
                        <controls:NumericBlock Grid.Column="2"
                                               Classes="OverlayRowMetric"
                                               Value="{Binding Sum.Damage}"
                                               IsVisible="{Binding Sum.Columns.ShowDamageColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="3"
                                               Classes="OverlayRowMetric OverlayRowHealing"
                                               Value="{Binding Sum.HealingPerSecond}"
                                               IsVisible="{Binding Sum.Columns.ShowHealingPerSecondColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0"
                                               Suffix="/s" />
                        <controls:NumericBlock Grid.Column="4"
                                               Classes="OverlayRowMetric OverlayRowHealing"
                                               Value="{Binding Sum.Healing}"
                                               IsVisible="{Binding Sum.Columns.ShowHealingColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="5"
                                               Classes="OverlayRowMetric OverlayRowDamageTaken"
                                               Value="{Binding Sum.DamageTaken}"
                                               IsVisible="{Binding Sum.Columns.ShowDamageTakenColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="6"
                                               Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                               Value="{Binding Sum.UnhealedHealthSeconds}"
                                               IsVisible="{Binding Sum.Columns.ShowUnhealedHealthColumn}"
                                               UseCompactNotation="{Binding Sum.Columns.UseCompactMainMetrics}"
                                               Formatter="N0"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="7"
                                               Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                               Value="{Binding Sum.RecoveryTime}"
                                               IsVisible="{Binding Sum.Columns.ShowRecoveryTimeColumn}"
                                               Formatter="{Binding Sum.RecoveryTime, Converter={x:Static controls:FightGraph.SecondsFormatter}}"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="8"
                                               Classes="OverlayRowMetric OverlayRowAggro"
                                               Value="{Binding Sum.AggroShare}"
                                               IsVisible="{Binding Sum.Columns.ShowAggroColumn}"
                                               Formatter="P0"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="9"
                                               Classes="OverlayRowMetric OverlayRowStagger"
                                               Value="{Binding Sum.StaggerShare}"
                                               IsVisible="{Binding Sum.Columns.ShowStaggerColumn}"
                                               Formatter="P0"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="10"
                                               Classes="OverlayRowMetric"
                                               Value="{Binding Sum.Kills}"
                                               IsVisible="{Binding Sum.Columns.ShowKillsColumn}"
                                               Formatter="N0"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="11"
                                               Classes="OverlayRowMetric"
                                               Value="{Binding Sum.LastHits}"
                                               IsVisible="{Binding Sum.Columns.ShowLastHitsColumn}"
                                               Formatter="N0"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="12"
                                               Classes="OverlayRowMetric"
                                               Value="{Binding Sum.Credited}"
                                               IsVisible="{Binding Sum.Columns.ShowCreditedColumn}"
                                               Formatter="N0"
                                               Margin="6,0,0,0" />
                        <controls:NumericBlock Grid.Column="13"
                                               Classes="CombatantBossShareValue"
                                               Value="{Binding Sum.BossShareRatio}"
                                               IsVisible="{Binding Sum.Columns.ShowBossShareColumn}"
                                               Formatter="P1"
                                               Margin="6,0,0,0" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainHudShell"
          Classes="MainHudShell"
          Grid.IsSharedSizeScope="True"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="0"
          controls:DisplayContextProvider.DisplayContext="{Binding DisplayContext}">
        <!-- The title line: with "Title line always clickable" on it takes clicks while the rest of the meter lets the mouse
             through to the game (FrameClickThrough; a click here gives the overlay focus). -->
        <Border x:Name="TitleLine"
                Grid.Row="0"
                Classes="MainHudHeader">
            <Grid>
                <Border x:Name="HeaderBackdrop"
                        Classes="MainHudHeaderBackdrop"
                        IsHitTestVisible="False" />

                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="2"
                      Margin="1,0">
                    <StackPanel x:Name="TitleBarLeft"
                                Grid.Column="0"
                                Classes="TitleBarActions"
                                Orientation="Horizontal"
                                Spacing="2">
                        <Button Classes="WindowBtn RefreshBtn"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding IsCapturing}"
                                ToolTip.Tip="{markups:Translate Action_BattleReset}">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource rotate-cw}" />
                        </Button>

                        <Button x:Name="EncounterHistoryButton"
                                Classes="WindowBtn"
                                Classes.active="{Binding IsViewingArchivedEncounter}"
                                ToolTip.Tip="{markups:Translate Column_History}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource history}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                            ShowMode="Transient"
                                            FlyoutPresenterClasses="EncounterHistoryMenuFlyout" />
                            </Button.Flyout>
                        </Button>

                        <!-- The overlay's navigation: each frame on or off (in gold while on), and the twin library. -->
                        <Button Classes="WindowBtn NavBtn"
                                Classes.active="{Binding SettingsFlyout.GroupFrameEnabled}"
                                Click="NavGroupFrameClicked"
                                ToolTip.Tip="{markups:Translate Settings_GroupFrame}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource heart-pulse}" />
                        </Button>
                        <Button Classes="WindowBtn NavBtn"
                                Classes.active="{Binding SettingsFlyout.SkillMonitorEnabled}"
                                Click="NavSkillMonitorClicked"
                                ToolTip.Tip="{markups:Translate Settings_SkillMonitor}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource timer}" />
                        </Button>
                        <Button Classes="WindowBtn NavBtn"
                                Classes.active="{Binding SettingsFlyout.FightGraphsEnabled}"
                                Click="NavFightGraphsClicked"
                                ToolTip.Tip="{markups:Translate Settings_FightGraphs}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource chart-line}" />
                        </Button>
                        <Button Classes="WindowBtn NavBtn"
                                Classes.active="{Binding SettingsFlyout.HiddenCubesEnabled}"
                                Click="NavHiddenCubesClicked"
                                ToolTip.Tip="{markups:Translate HiddenCubes_Title}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource box}" />
                        </Button>

                        <Button Classes="WindowBtn NavBtn"
                                Classes.active="{Binding IsTwinLibraryOpen}"
                                Click="TwinLibraryClicked"
                                ToolTip.Tip="{markups:Translate TwinLibrary_Title}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource users}" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1"
                            x:Name="TitleBarDragRegion"
                            Classes="TitleBarDragRegion">
                        <controls:MapDisplay Classes="OverlayHeaderScene"
                                             MapId="{Binding LiveSceneMapId}"
                                             ShowIcon="False"
                                             UseBrackets="False"
                                             MinWidth="0"
                                             IsHitTestVisible="False"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="2"
                                Classes="TitleBarActions"
                                Orientation="Horizontal"
                                Spacing="2">
                        <!-- The tutorial, until it was done once (then Settings → General starts it again). -->
                        <Button x:Name="TutorialButton"
                                Classes="WindowBtn"
                                Click="TutorialClicked"
                                IsVisible="{Binding !SettingsFlyout.TutorialDone}"
                                ToolTip.Tip="{markups:Translate Tutorial_ButtonTip}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource circle-help}" />
                        </Button>

                        <Button Classes="WindowBtn MinBtn"
                                Click="Minimize">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource minus}" />
                        </Button>

                        <!-- Like the other frames' eye: folds the meter to its title and bottom bar, shut while folded. -->
                        <Button Classes="WindowBtn"
                                Click="MeterEyeClicked"
                                ToolTip.Tip="{markups:Translate Meter_MinimizeTip}">
                            <Panel>
                                <Path Classes="Glyph GlyphMd" Data="{StaticResource eye}" IsVisible="{Binding !IsMeterFolded}" />
                                <Path Classes="Glyph GlyphMd" Data="{StaticResource eye-off}" IsVisible="{Binding IsMeterFolded}" />
                            </Panel>
                        </Button>

                        <Button Classes="WindowBtn CloseBtn"
                                Click="Exit">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="5"
                x:Name="ContentBackdrop"
                Classes="MainHudContentBackdrop"
                IsHitTestVisible="False" />

        <!-- Folded (the eye): only the title and the bottom bar stay. -->
        <Grid Grid.Row="1"
              Grid.RowSpan="4"
              RowDefinitions="Auto,Auto,Auto,Auto"
              IsVisible="{Binding !IsMeterFolded}">
            <ItemsControl Grid.Row="0"
                          Classes="BossFocusList"
                          ItemsSource="{Binding BossFocuses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BossFocusViewModel">
                        <Border Classes="BossFocusPanel">
                            <StackPanel>
                            <Grid Height="26"
                                  Margin="4,2,4,4">
                                <controls:BossFocusProgressBar Classes="BossFocusHpBar"
                                                               Segment="{Binding BarSegment}"
                                                               IsHitTestVisible="False" />

                                <Grid Margin="16,0,5,0"
                                      ColumnSpacing="6"
                                      IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricTertiary" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="4"
                                          MinWidth="0"
                                          VerticalAlignment="Center">
                                        <controls:NpcDisplay Grid.Column="0"
                                                             Classes="BossFocusName"
                                                             ShowIcon="False"
                                                             IconSpacing="0"
                                                             EntityId="{Binding InstanceId}"
                                                             NpcCode="{Binding NpcCode}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Classes="BossFocusCountBadge"
                                                IsVisible="{Binding HasMultipleInstances}"
                                                VerticalAlignment="Center">
                                            <TextBlock Classes="BossFocusCountText"
                                                       Text="{Binding InstanceCountText}" />
                                        </Border>
                                    </Grid>

                                    <controls:NumericBlock Grid.Column="1"
                                                           Classes="BossFocusHp"
                                                           Value="{Binding Hp}"
                                                           Formatter="N0"
                                                           UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           IsVisible="{Binding IsHpVisible}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsHpUnknown}"
                                               VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="2"
                                                           Classes="BossFocusHpMuted"
                                                           Value="{Binding MaxHp}"
                                                           Formatter="N0"
                                                           UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           IsVisible="{Binding IsMaxHpVisible}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsMaxHpUnknown}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsHpUnknown}"
                                               VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="3"
                                                           Classes="BossFocusPercent"
                                                           Value="{Binding HpRatio}"
                                                           Formatter="P0"
                                                           IsVisible="{Binding IsMaxHpVisible}"
                                                           VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Stagger gauge: empties as stagger skills land; at 0 the boss is staggered and it refills. -->
                            <Grid Margin="20,0,9,3"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="6"
                                  IsVisible="{Binding HasStagger}"
                                  ToolTip.Tip="{markups:Translate BossFocus_StaggerTip}">
                                <Border Grid.Column="0"
                                        Classes="BossStaggerTrack" />
                                <controls:SlantedProgressBar Grid.Column="0"
                                                             Classes="BossStaggerBar"
                                                             Segment="{Binding StaggerSegment}"
                                                             IsHitTestVisible="False" />
                                <TextBlock Grid.Column="1"
                                           Classes="BossStaggerText"
                                           Text="{Binding StaggerText}" />
                            </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border x:Name="BossSection"
                    Grid.Row="1"
                    Classes="BossSection"
                    IsVisible="{Binding CurrentBossFight.IsVisible}">
                <ContentControl Content="{Binding CurrentBossFight}"
                                ContentTemplate="{StaticResource BossFightTemplate}" />
            </Border>

            <StackPanel Grid.Row="2">
                <ContentControl Content="{Binding}"
                                ContentTemplate="{StaticResource CombatantColumnHeaderTemplate}" />

                <controls:AnimatedItemsView ItemSpacing="3"
                                             ItemsSource="{Binding Combatants}"
                                             SelectedItem="{Binding SelectedCombatant, Mode=TwoWay}"
                                             MaxVisibleItems="{Binding SettingsFlyout.MaxVisibleCombatantRows}"
                                             ItemHeight="36"
                                             MoveDuration="0:0:0.16"
                                             AddRemoveDuration="0:0:0.14"
                                             AddRemoveOffset="16">
                    <controls:AnimatedItemsView.EmptyTemplate>
                        <DataTemplate x:DataType="vm:MainViewModel">
                            <Border Padding="0,10">
                                <TextBlock Classes="OverlayMutedText OverlayEmptyStateText"
                                           Text="{markups:Translate Empty_Combatants}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:AnimatedItemsView.EmptyTemplate>

                    <controls:AnimatedItemsView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CombatantRowViewModel">
                            <Border Name="RowRoot"
                                    Classes="OverlayRowCard"
                                    Tapped="CombatantRowTapped">
                                <!-- The bar under the selection, which would hide under it. -->
                                <Grid>
                                    <controls:SlantedProgressBar Classes="CombatantRowBar"
                                                                 Segment="{Binding BarSegment}"
                                                                 IsHitTestVisible="False" />

                                    <controls:QuestSelectionHighlight Classes="CombatantRowSelection"
                                                                      IsActive="{Binding $parent[controls:AnimatedItemsViewItem].IsSelected}"
                                                                      IsHitTestVisible="False" />

                                    <Border Classes="OverlayRowHover" IsHitTestVisible="False" />

                                    <Grid Margin="5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricRecoveryTime" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricKills" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricLastHits" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricCredited" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                                        </Grid.ColumnDefinitions>
                                        <controls:PcDisplay Grid.Column="0"
                                                            Classes="OverlayRowName"
                                                            IconSize="36"
                                                            IconSpacing="4"
                                                            EntityId="{Binding Id}"
                                                            VerticalAlignment="Stretch" />

                                        <controls:NumericBlock Grid.Column="1"
                                                               Classes="OverlayRowMetricStrong"
                                                               Value="{Binding DamagePerSecond}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                                                               IsVisible="{Binding Columns.ShowDamagePerSecondColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0"
                                                               Suffix="/s" />

                                        <controls:NumericBlock Grid.Column="2"
                                                               Classes="OverlayRowMetric"
                                                               Value="{Binding Damage}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                                                               IsVisible="{Binding Columns.ShowDamageColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="3"
                                                               Classes="OverlayRowMetricStrong OverlayRowHealing"
                                                               Value="{Binding HealingPerSecond}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                                                               IsVisible="{Binding Columns.ShowHealingPerSecondColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0"
                                                               Suffix="/s" />

                                        <controls:NumericBlock Grid.Column="4"
                                                               Classes="OverlayRowMetric OverlayRowHealing"
                                                               Value="{Binding Healing}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                                                               IsVisible="{Binding Columns.ShowHealingColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="5"
                                                               Classes="OverlayRowMetric OverlayRowDamageTaken"
                                                               Value="{Binding DamageTaken}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                                                               IsVisible="{Binding Columns.ShowDamageTakenColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="6"
                                                               Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                               Value="{Binding UnhealedHealthSeconds}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                                                               IsVisible="{Binding Columns.ShowUnhealedHealthColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="7"
                                                               Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                               Value="{Binding RecoveryTime}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_RecoveryTimeTip}"
                                                               IsVisible="{Binding Columns.ShowRecoveryTimeColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               Formatter="{Binding RecoveryTime, Converter={x:Static controls:FightGraph.SecondsFormatter}}"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="8"
                                                               Classes="OverlayRowMetric OverlayRowAggro"
                                                               Value="{Binding AggroShare}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                                                               IsVisible="{Binding Columns.ShowAggroColumn}"
                                                               Formatter="P0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="9"
                                                               Classes="OverlayRowMetric OverlayRowStagger"
                                                               Value="{Binding StaggerShare}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                                                               IsVisible="{Binding Columns.ShowStaggerColumn}"
                                                               Formatter="P0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="10"
                                                               Classes="OverlayRowMetric"
                                                               Value="{Binding Kills}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_KillsTip}"
                                                               IsVisible="{Binding Columns.ShowKillsColumn}"
                                                               Formatter="N0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="11"
                                                               Classes="OverlayRowMetric"
                                                               Value="{Binding LastHits}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_LastHitsTip}"
                                                               IsVisible="{Binding Columns.ShowLastHitsColumn}"
                                                               Formatter="N0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="12"
                                                               Classes="OverlayRowMetric"
                                                               Value="{Binding Credited}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_CreditedTip}"
                                                               IsVisible="{Binding Columns.ShowCreditedColumn}"
                                                               Formatter="N0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="13"
                                                               Classes="CombatantBossShareValue"
                                                               Value="{Binding BossShareRatio}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                                                               IsVisible="{Binding Columns.ShowBossShareColumn}"
                                                               Formatter="P1"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </controls:AnimatedItemsView.ItemTemplate>
                </controls:AnimatedItemsView>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        IsVisible="{Binding HasBossFights}">
                <Button Classes="BossSectionHeader"
                        Command="{Binding ToggleBossFightListCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="6">
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-down}"
                              IsVisible="{Binding IsBossFightListExpanded}" />
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-right}"
                              IsVisible="{Binding !IsBossFightListExpanded}" />
                        <TextBlock Grid.Column="1"
                                   Classes="BossSectionTitle"
                                   Text="{Binding BossFightListTitle}" />
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding BossFights}"
                              ItemTemplate="{StaticResource BossFightTemplate}"
                              IsVisible="{Binding IsBossFightListExpanded}"
                              Margin="8,0,0,3" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5"
                Classes="MainHudFooterSeparator"
                IsHitTestVisible="False" />

        <Border Grid.Row="5"
                Classes="MainHudFooter">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  Margin="2,0">
                <Button Grid.Column="0"
                        Classes="BottomBarButton"
                        VerticalAlignment="Center"
                        Click="SettingsClicked"
                        ToolTip.Tip="{markups:Translate Settings_Title}">
                    <Path Classes="Glyph GlyphMd" Data="{StaticResource settings}" />
                </Button>

                <!-- Clipped: on the narrowest meter (334 px) with a boss time limit's DPS check, the FPS's end is cut off
                     rather than drawn over the figures on the right. -->
                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Spacing="6"
                            VerticalAlignment="Center"
                            ClipToBounds="True"
                            ToolTip.Tip="{Binding Status}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding DriverIndicatorColor}"
                                ToolTip.Tip="{Binding DriverIndicatorToolTip}" />
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding GamePortIndicatorColor}"
                                ToolTip.Tip="{Binding GamePortIndicatorToolTip}" />
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding CaptureLockIndicatorColor}"
                                ToolTip.Tip="{Binding CaptureLockIndicatorToolTip}" />
                    </StackPanel>

                    <!-- The ping, and in brackets what 99 % of the last two minutes' pings stayed at or below; a click opens
                         the last hour's pings below it (PingPopup), another click closes them. -->
                    <Button x:Name="PingButton"
                            Classes="BottomBarButton PingButton"
                            VerticalAlignment="Center"
                            Click="PingButtonClicked"
                            ToolTip.Tip="{Binding LatencyToolTip}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Path Classes="Glyph GlyphMd BottomBarSignalGlyph"
                                  Data="{StaticResource wifi}"
                                  Stroke="{Binding LatencyIndicatorColor}" />
                            <controls:NumericBlock Classes="BottomBarMetric"
                                                   Value="{Binding RoundTripTimeMilliseconds}"
                                                   Suffix=" ms"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                            <TextBlock Classes="BottomBarPingPercentile"
                                       Text="{Binding PingPercentileText}"
                                       IsVisible="{Binding PingPercentileText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                    </Button>

                    <!-- The game's frames per second while they're counted (GameFrameRate); a click opens their last ten
                         minutes below the meter, right of the ping graph while that's open. -->
                    <Button x:Name="FrameRateButton"
                            Classes="BottomBarButton PingButton"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasFrameRate}"
                            Click="FrameRateButtonClicked"
                            ToolTip.Tip="{markups:Translate Footer_FrameRateTip}">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Path Classes="Glyph GlyphMd BottomBarSignalGlyph"
                                  Data="{StaticResource monitor}" />
                            <controls:NumericBlock Classes="BottomBarMetric"
                                                   Value="{Binding FrameRate}"
                                                   Formatter="N0"
                                                   Suffix=" fps"
                                                   TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                        </StackPanel>
                    </Button>

                    <!-- The odyle energy as the game shows it (OdyleEnergy): what there is, in brackets what recharge items
                         added, and the most there can be, coloured as there; or, as the settings pick, the rewards it pays
                         for or the runs with premium. The hover text shows all of them and the time to the next +15. -->
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasOdyle}"
                                Background="Transparent"
                                ToolTip.Tip="{Binding OdyleToolTip}">
                        <Image Source="avares://Aion2Heal/Assets/Images/Odyle.png"
                               Width="16"
                               Height="16"
                               VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding OdyleCountText, Converter={x:Static ObjectConverters.IsNull}}">
                            <TextBlock Classes="BottomBarOdyle"
                                       Text="{Binding OdyleValueText}" />
                            <TextBlock Classes="BottomBarOdyle OdyleBracket"
                                       Text="{Binding OdyleBracketText}" />
                            <TextBlock Classes="BottomBarOdyle"
                                       Text="{Binding OdyleMaximumText}" />
                        </StackPanel>
                        <TextBlock Classes="BottomBarOdyle"
                                   Text="{Binding OdyleCountText}"
                                   IsVisible="{Binding OdyleCountText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <!-- The group's recovery time, with its column. -->
                    <controls:NumericBlock Classes="BottomBarMetric BottomBarTotalUnhealedHealth"
                                           IsVisible="{Binding CombatantColumns.ShowRecoveryTimeColumn}"
                                           Value="{Binding TotalRecoveryTime}"
                                           Formatter="{Binding TotalRecoveryTime, Converter={x:Static controls:FightGraph.SecondsFormatter}}"
                                           StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                           ToolTip.Tip="{markups:Translate Footer_RecoveryTimeTip}"
                                           Margin="0,0,5,0"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                    <controls:NumericBlock Classes="BottomBarMetric BottomBarTotalUnhealedHealth"
                                           IsVisible="{Binding CombatantColumns.ShowUnhealedHealthColumn}"
                                           Value="{Binding TotalUnhealedHealthSeconds}"
                                           Formatter="N0"
                                           UseCompactNotation="{Binding CombatantColumns.UseCompactMainMetrics}"
                                           CompactThreshold="1000"
                                           CompactSignificantDigits="3"
                                           StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                           ToolTip.Tip="{markups:Translate Footer_UnhealedHealthTip}"
                                           Margin="0,0,5,0"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                    <controls:NumericBlock Classes="BottomBarMetric BottomBarTotalDps"
                                           IsVisible="{Binding CombatantColumns.ShowTotalDamagePerSecond}"
                                           Value="{Binding TotalFilteredDamagePerSecond}"
                                           Suffix="/s"
                                           Formatter="N0"
                                           UseCompactNotation="{Binding CombatantColumns.UseCompactMainMetrics}"
                                           CompactThreshold="1000"
                                           CompactSignificantDigits="3"
                                           StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                           ToolTip.Tip="{markups:Translate Footer_DpsTip}"
                                           Margin="0,0,5,0"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                    <!-- The boss section's DPS check, folded or not: how much the group is ahead (green) or behind (red). -->
                    <TextBlock Classes="BossSectionGap"
                               Classes.behind="{Binding CurrentBossFight.IsBehind}"
                               IsVisible="{Binding CurrentBossFight.HasDpsCheck}"
                               Text="{Binding CurrentBossFight.DpsGapShortText}"
                               FontSize="{StaticResource AppFontSize.Body}"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />

                    <controls:DurationBlock Classes="BottomBarMetric"
                                            Duration="{Binding EncounterDuration}"
                                            DisplayFormat="{Binding SettingsFlyout.EncounterTimeDisplayFormat}"
                                            StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{markups:Translate Footer_DurationTip}" />

                    <!-- The hand (FrameChrome.AttachHand): whether the meter takes clicks while the game has focus; a click
                         turns that round. Shown while the overlay has focus (OverlayTheme). -->
                    <Button x:Name="HandButton"
                            Classes="BottomBarButton MeterHand"
                            VerticalAlignment="Center" />
                </StackPanel>

                <!-- The last hour's pings below the meter and the game's frame rate (the monitor icon's), each on its own
                     or side by side, the ping's on the left. Each stays open until its icon is clicked again, both until
                     the meter is folded: no light dismiss, so a click elsewhere or the game taking focus leaves them open.
                     Placed at
                     the whole meter, they follow it as it moves, grows or shrinks, and near the screen's bottom they go
                     above it rather than over its rows. While the meter's body lets the mouse through to the game, so do
                     they (ApplyPopupClickThrough). They go by the meter's UI scale (every Popup inherits it, CommonTheme),
                     and have a size of their own on top (GraphsScale, ApplyGraphsScale: at 100 % both side by side are as
                     wide as the meter) and an opacity of their own like the meter's (ApplyOpacity). The hints show only
                     while the overlay has focus (OverlayTheme). -->
                <Popup x:Name="PingPopup"
                       PlacementTarget="{Binding #MainHudShell}"
                       Placement="BottomEdgeAlignedLeft"
                       IsLightDismissEnabled="False"
                       Opened="PingPopupOpened">
                    <LayoutTransformControl x:Name="GraphsScale">
                        <FlyoutPresenter x:Name="GraphsPresenter"
                                         Classes="FooterGraphs">
                            <Panel>
                                <Border x:Name="PingBackdrop"
                                        Classes="MainHudContentBackdrop"
                                        IsHitTestVisible="False" />
                                <StackPanel x:Name="GraphsRow"
                                            Margin="8"
                                            Orientation="Horizontal"
                                            Spacing="12">
                                    <StackPanel x:Name="PingGraphPanel"
                                                Width="320"
                                                Spacing="4">
                                        <controls:PingGraph History="{Binding PingHistory}"
                                                            Smooth="{Binding SettingsFlyout.PingGraphSmooth}"
                                                            PingLabel="{markups:Translate PingGraph_Ping}"
                                                            PercentileLabel="{markups:Translate PingGraph_Percentile}"
                                                            EmptyText="{markups:Translate PingGraph_Empty}"
                                                            Height="140" />
                                        <TextBlock Classes="PingGraphHint"
                                                   TextWrapping="Wrap"
                                                   Text="{markups:Translate PingGraph_Hint}" />
                                    </StackPanel>
                                    <StackPanel x:Name="FrameRateGraphPanel"
                                                Width="320"
                                                Spacing="4"
                                                IsVisible="False">
                                        <controls:PingGraph History="{Binding FrameRateHistory}"
                                                            Smooth="{Binding SettingsFlyout.FrameRateGraphSmooth}"
                                                            ShowsFrameRate="True"
                                                            PingLabel="{markups:Translate FrameRateGraph_Fps}"
                                                            PercentileLabel="{markups:Translate FrameRateGraph_Low}"
                                                            EmptyText="{markups:Translate FrameRateGraph_Empty}"
                                                            Height="140" />
                                        <TextBlock Classes="PingGraphHint"
                                                   TextWrapping="Wrap"
                                                   Text="{markups:Translate FrameRateGraph_Hint}" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </FlyoutPresenter>
                    </LayoutTransformControl>
                </Popup>
            </Grid>
        </Border>
    </Grid>

    <FlyoutBase.AttachedFlyout>
        <Flyout ShowMode="Transient"
                Opened="FlyoutOpened"
                Closed="FlyoutClosed">
            <views:CombatantDetailsFlyoutView x:Name="CombatantDetailsFlyoutView"
                                              DataContext="{Binding CombatantDetails}" />
        </Flyout>
    </FlyoutBase.AttachedFlyout>
</Window>
