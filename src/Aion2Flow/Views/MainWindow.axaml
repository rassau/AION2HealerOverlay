<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
        xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
        xmlns:controls="clr-namespace:Cloris.Aion2Flow.Controls"
        xmlns:views="clr-namespace:Cloris.Aion2Flow.Views"
        x:Class="Cloris.Aion2Flow.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Classes="OverlayWindow"
        WindowDecorations="None"
        TransparencyLevelHint="Transparent"
        Width="300"
        SizeToContent="Height"
        CanResize="False"
        CanMaximize="False"
        ShowActivated="False"
        Title="Aion2Heal"
        Icon="/Assets/Images/Aion2Heal.png">

    <Window.Styles>
        <StyleInclude Source="avares://Aion2Heal/Styles/OverlayTheme.axaml" />
    </Window.Styles>

    <Window.Resources>
        <!-- Column headings over the main table and over each boss fight's rows: the shared size groups line them up with the
             values below. A click on one sorts every table by its column, the highest first; another click the other way
             round. The column the rows go by has the arrow, as in the fight graphs' runs tables. -->
        <DataTemplate x:Key="CombatantColumnHeaderTemplate" x:DataType="vm:MainViewModel">
            <Grid Margin="5,0,5,1"
                  IsVisible="{Binding SettingsFlyout.ShowColumnHeaders}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                    <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="1"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.DamagePerSecond}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamagePerSecondColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Dps}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.DamagePerSecond}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.TotalDamage}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamageColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Damage}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.TotalDamage}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="3"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.HealingPerSecond}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                        IsVisible="{Binding CombatantColumns.ShowHealingPerSecondColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Hps}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.HealingPerSecond}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="4"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.TotalHealing}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                        IsVisible="{Binding CombatantColumns.ShowHealingColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Healing}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.TotalHealing}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="5"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.DamageTaken}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                        IsVisible="{Binding CombatantColumns.ShowDamageTakenColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_DamageTaken}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.DamageTaken}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="6"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.UnhealedHealth}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                        IsVisible="{Binding CombatantColumns.ShowUnhealedHealthColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_UnhealedHealth}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.UnhealedHealth}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="7"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Aggro}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                        IsVisible="{Binding CombatantColumns.ShowAggroColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Aggro}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Aggro}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="8"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.Stagger}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                        IsVisible="{Binding CombatantColumns.ShowStaggerColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_Stagger}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.Stagger}}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="9"
                        Classes="OverlayColumnHeader"
                        Command="{Binding SettingsFlyout.SortByCommand}"
                        CommandParameter="{x:Static vm:CombatantSortMetric.BossShare}"
                        ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                        IsVisible="{Binding CombatantColumns.ShowBossShareColumn}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{markups:Translate ColumnHeader_BossShare}" />
                        <TextBlock Text="{Binding SettingsFlyout.SortArrow}"
                                   IsVisible="{Binding SettingsFlyout.CombatantSortMetric, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static vm:CombatantSortMetric.BossShare}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- A boss fight: a header that folds it, the DPS check, and the main table's columns over the fight. -->
        <DataTemplate x:Key="BossFightTemplate" x:DataType="vm:BossFightViewModel">
            <StackPanel Spacing="0">
                <Button Classes="BossSectionHeader"
                        Command="{Binding ToggleExpandedCommand}"
                        ToolTip.Tip="{markups:Translate BossSection_Toggle}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                          ColumnSpacing="6">
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-down}"
                              IsVisible="{Binding IsExpanded}" />
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-right}"
                              IsVisible="{Binding !IsExpanded}" />
                        <TextBlock Grid.Column="1"
                                   Classes="BossSectionTitle"
                                   Text="{Binding Title}" />
                        <TextBlock Grid.Column="2"
                                   Classes="BossSectionCheck"
                                   Text="{Binding DetailText}" />
                        <controls:DurationBlock Grid.Column="3"
                                                Classes="BossSectionMetric"
                                                Duration="{Binding Duration}"
                                                DisplayFormat="{Binding $parent[Window].DataContext.SettingsFlyout.EncounterTimeDisplayFormat}"
                                                VerticalAlignment="Center" />
                        <controls:NumericBlock Grid.Column="4"
                                               Classes="BossSectionMetric"
                                               Value="{Binding DamagePerSecond}"
                                               Suffix="/s"
                                               Formatter="N0"
                                               UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                               CompactThreshold="1000"
                                               CompactSignificantDigits="3"
                                               VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal"
                            Spacing="4"
                            Margin="24,0,5,2"
                            IsVisible="{Binding IsDpsCheckVisible}">
                    <TextBlock Classes="BossSectionCheck"
                               Text="{Binding DpsCheckText}" />
                    <TextBlock Classes="BossSectionCheck BossSectionGap"
                               Classes.behind="{Binding IsBehind}"
                               Text="{Binding DpsGapText}" />
                </StackPanel>

                <ContentControl Content="{Binding $parent[Window].DataContext}"
                                ContentTemplate="{StaticResource CombatantColumnHeaderTemplate}"
                                IsVisible="{Binding IsExpanded}" />

                <ItemsControl ItemsSource="{Binding Rows}"
                              IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CombatantRowViewModel">
                            <Grid Height="22"
                                  Background="Transparent"
                                  Tapped="CombatantRowTapped">
                                <controls:SlantedProgressBar Classes="BossFightRowBar"
                                                             Segment="{Binding BarSegment}"
                                                             IsHitTestVisible="False" />

                                <Grid Margin="5,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PcDisplay Grid.Column="0"
                                                        Classes="BossSectionName"
                                                        IconSize="20"
                                                        IconSpacing="4"
                                                        EntityId="{Binding Id}"
                                                        VerticalAlignment="Stretch" />
                                    <controls:NumericBlock Grid.Column="1"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding DamagePerSecond}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                                                           IsVisible="{Binding Columns.ShowDamagePerSecondColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0"
                                                           Suffix="/s" />
                                    <controls:NumericBlock Grid.Column="2"
                                                           Classes="OverlayRowMetric"
                                                           Value="{Binding Damage}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                                                           IsVisible="{Binding Columns.ShowDamageColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="3"
                                                           Classes="OverlayRowMetric OverlayRowHealing"
                                                           Value="{Binding HealingPerSecond}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                                                           IsVisible="{Binding Columns.ShowHealingPerSecondColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0"
                                                           Suffix="/s" />
                                    <controls:NumericBlock Grid.Column="4"
                                                           Classes="OverlayRowMetric OverlayRowHealing"
                                                           Value="{Binding Healing}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                                                           IsVisible="{Binding Columns.ShowHealingColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="5"
                                                           Classes="OverlayRowMetric OverlayRowDamageTaken"
                                                           Value="{Binding DamageTaken}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                                                           IsVisible="{Binding Columns.ShowDamageTakenColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="6"
                                                           Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                           Value="{Binding UnhealedHealthSeconds}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                                                           IsVisible="{Binding Columns.ShowUnhealedHealthColumn}"
                                                           UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                           Formatter="N0"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="7"
                                                           Classes="OverlayRowMetric OverlayRowAggro"
                                                           Value="{Binding AggroShare}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                                                           IsVisible="{Binding Columns.ShowAggroColumn}"
                                                           Formatter="P0"
                                                           Margin="6,0,0,0" />
                                    <controls:NumericBlock Grid.Column="8"
                                                           Classes="OverlayRowMetric OverlayRowStagger"
                                                           Value="{Binding StaggerShare}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                                                           IsVisible="{Binding Columns.ShowStaggerColumn}"
                                                           Formatter="P0"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="9"
                                                           Classes="CombatantBossShareValue"
                                                           Value="{Binding BossShareRatio}"
                                                           ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                                                           IsVisible="{Binding Columns.ShowBossShareColumn}"
                                                           Formatter="P1"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="MainHudShell"
          Classes="MainHudShell"
          Grid.IsSharedSizeScope="True"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          RowSpacing="0"
          PointerEntered="MainHudShellPointerEntered"
          controls:DisplayContextProvider.DisplayContext="{Binding DisplayContext}">
        <Border Grid.Row="0"
                Classes="MainHudHeader">
            <Grid>
                <Border x:Name="HeaderBackdrop"
                        Classes="MainHudHeaderBackdrop"
                        IsHitTestVisible="False" />

                <Grid Classes="MainHudForeground"
                      ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="2"
                      Margin="1,0">
                    <StackPanel Grid.Column="0"
                                Classes="TitleBarActions"
                                Orientation="Horizontal"
                                Spacing="2">
                        <Button Classes="WindowBtn RefreshBtn"
                                Command="{Binding ResetCommand}"
                                IsEnabled="{Binding IsCapturing}"
                                ToolTip.Tip="{markups:Translate Action_BattleReset}">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource rotate-cw}" />
                        </Button>

                        <Button x:Name="EncounterHistoryButton"
                                Classes="WindowBtn"
                                Classes.active="{Binding IsViewingArchivedEncounter}"
                                ToolTip.Tip="{markups:Translate Column_History}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource history}" />
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                                            ShowMode="Transient"
                                            FlyoutPresenterClasses="EncounterHistoryMenuFlyout" />
                            </Button.Flyout>
                        </Button>

                        <Button Classes="WindowBtn"
                                Click="TwinLibraryClicked"
                                ToolTip.Tip="{markups:Translate TwinLibrary_Title}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource users}" />
                        </Button>

                        <!-- Look the player up again: a new snapshot of their own twin in the library. -->
                        <Button Classes="WindowBtn"
                                Classes.active="{Binding IsOwnTwinLoading}"
                                Command="{Binding RefreshOwnTwinCommand}"
                                ToolTip.Tip="{Binding OwnTwinToolTip}">
                            <Path Classes="Glyph GlyphMd" Data="{StaticResource user-refresh}" />
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Classes="TitleBarDragRegion"
                            PointerPressed="TitleBarDragRegionPointerPressed">
                        <Grid ColumnDefinitions="Auto,*"
                              IsHitTestVisible="False">
                            <Path Classes="Glyph GlyphSm"
                                  Data="{StaticResource chevron-down}"
                                  IsVisible="{Binding !IsMeterFolded}"
                                  VerticalAlignment="Center" />
                            <Path Classes="Glyph GlyphSm"
                                  Data="{StaticResource chevron-right}"
                                  IsVisible="{Binding IsMeterFolded}"
                                  VerticalAlignment="Center" />
                            <controls:MapDisplay Grid.Column="1"
                                                 Classes="OverlayHeaderScene"
                                                 MapId="{Binding LiveSceneMapId}"
                                                 ShowIcon="False"
                                                 UseBrackets="False"
                                                 MinWidth="0"
                                                 IsHitTestVisible="False"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2"
                                Classes="TitleBarActions"
                                Orientation="Horizontal"
                                Spacing="2">
                        <Button Classes="WindowBtn MinBtn"
                                Click="Minimize">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource minus}" />
                        </Button>

                        <Button Classes="WindowBtn CloseBtn"
                                Click="Exit">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Grid.RowSpan="5"
                x:Name="ContentBackdrop"
                Classes="MainHudContentBackdrop"
                IsHitTestVisible="False" />

        <!-- Folded (a click on the title): only the title and the bottom bar stay. -->
        <Grid Grid.Row="1"
              Grid.RowSpan="4"
              RowDefinitions="Auto,Auto,Auto,Auto"
              IsVisible="{Binding !IsMeterFolded}">
            <ItemsControl Grid.Row="0"
                          Classes="BossFocusList MainHudForeground"
                          ItemsSource="{Binding BossFocuses}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" Spacing="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BossFocusViewModel">
                        <Border Classes="BossFocusPanel">
                            <StackPanel>
                            <Grid Height="26"
                                  Margin="4,2,4,4">
                                <controls:BossFocusProgressBar Classes="BossFocusHpBar"
                                                               Segment="{Binding BarSegment}"
                                                               IsHitTestVisible="False" />

                                <Grid Margin="16,0,5,0"
                                      ColumnSpacing="6"
                                      IsHitTestVisible="False">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricPrimary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricSecondary" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="BossMetricTertiary" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0"
                                          ColumnDefinitions="*,Auto"
                                          ColumnSpacing="4"
                                          MinWidth="0"
                                          VerticalAlignment="Center">
                                        <controls:NpcDisplay Grid.Column="0"
                                                             Classes="BossFocusName"
                                                             ShowIcon="False"
                                                             IconSpacing="0"
                                                             EntityId="{Binding InstanceId}"
                                                             NpcCode="{Binding NpcCode}"
                                                             HorizontalAlignment="Stretch"
                                                             VerticalAlignment="Center" />
                                        <Border Grid.Column="1"
                                                Classes="BossFocusCountBadge"
                                                IsVisible="{Binding HasMultipleInstances}"
                                                VerticalAlignment="Center">
                                            <TextBlock Classes="BossFocusCountText"
                                                       Text="{Binding InstanceCountText}" />
                                        </Border>
                                    </Grid>

                                    <controls:NumericBlock Grid.Column="1"
                                                           Classes="BossFocusHp"
                                                           Value="{Binding Hp}"
                                                           Formatter="N0"
                                                           UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           IsVisible="{Binding IsHpVisible}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsHpUnknown}"
                                               VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="2"
                                                           Classes="BossFocusHpMuted"
                                                           Value="{Binding MaxHp}"
                                                           Formatter="N0"
                                                           UseCompactNotation="{Binding $parent[Window].DataContext.CombatantColumns.UseCompactMainMetrics}"
                                                           CompactThreshold="1000"
                                                           CompactSignificantDigits="3"
                                                           IsVisible="{Binding IsMaxHpVisible}"
                                                           VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsMaxHpUnknown}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Classes="BossFocusHpMuted"
                                               Text="--"
                                               IsVisible="{Binding IsHpUnknown}"
                                               VerticalAlignment="Center" />

                                    <controls:NumericBlock Grid.Column="3"
                                                           Classes="BossFocusPercent"
                                                           Value="{Binding HpRatio}"
                                                           Formatter="P0"
                                                           IsVisible="{Binding IsMaxHpVisible}"
                                                           VerticalAlignment="Center" />
                                </Grid>
                            </Grid>

                            <!-- Stagger gauge: empties as stagger skills land; at 0 the boss is staggered and it refills. -->
                            <Grid Margin="20,0,9,3"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="6"
                                  IsVisible="{Binding HasStagger}"
                                  ToolTip.Tip="{markups:Translate BossFocus_StaggerTip}">
                                <Border Grid.Column="0"
                                        Classes="BossStaggerTrack" />
                                <controls:SlantedProgressBar Grid.Column="0"
                                                             Classes="BossStaggerBar"
                                                             Segment="{Binding StaggerSegment}"
                                                             IsHitTestVisible="False" />
                                <TextBlock Grid.Column="1"
                                           Classes="BossStaggerText"
                                           Text="{Binding StaggerText}" />
                            </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1"
                    Classes="BossSection MainHudForeground"
                    IsVisible="{Binding CurrentBossFight.IsVisible}">
                <ContentControl Content="{Binding CurrentBossFight}"
                                ContentTemplate="{StaticResource BossFightTemplate}" />
            </Border>

            <StackPanel Grid.Row="2">
                <ContentControl Classes="MainHudForeground"
                                Content="{Binding}"
                                ContentTemplate="{StaticResource CombatantColumnHeaderTemplate}" />

                <controls:AnimatedItemsView Classes="MainHudForeground"
                                             ItemSpacing="1"
                                             ItemsSource="{Binding Combatants}"
                                             SelectedItem="{Binding SelectedCombatant, Mode=TwoWay}"
                                             MaxVisibleItems="{Binding SettingsFlyout.MaxVisibleCombatantRows}"
                                             ItemHeight="36"
                                             MoveDuration="0:0:0.16"
                                             AddRemoveDuration="0:0:0.14"
                                             AddRemoveOffset="16">
                    <controls:AnimatedItemsView.EmptyTemplate>
                        <DataTemplate x:DataType="vm:MainViewModel">
                            <Border Padding="0,10">
                                <TextBlock Classes="OverlayMutedText OverlayEmptyStateText"
                                           Text="{markups:Translate Empty_Combatants}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </controls:AnimatedItemsView.EmptyTemplate>

                    <controls:AnimatedItemsView.ItemTemplate>
                        <DataTemplate x:DataType="vm:CombatantRowViewModel">
                            <Border Name="RowRoot"
                                    Classes="OverlayRowCard"
                                    Tapped="CombatantRowTapped">
                                <Grid>
                                    <controls:QuestSelectionHighlight Classes="CombatantRowSelection"
                                                                      IsActive="{Binding $parent[controls:AnimatedItemsViewItem].IsSelected}"
                                                                      IsHitTestVisible="False" />

                                    <controls:SlantedProgressBar Classes="CombatantRowBar"
                                                                 Segment="{Binding BarSegment}"
                                                                 IsHitTestVisible="False" />

                                    <Grid Margin="5,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricPrimary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricSecondary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingPrimary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricHealingSecondary" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricDamageTaken" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricUnhealedHealth" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricAggro" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricStagger" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="CombatantMetricTertiary" />
                                        </Grid.ColumnDefinitions>
                                        <controls:PcDisplay Grid.Column="0"
                                                            Classes="OverlayRowName"
                                                            IconSize="36"
                                                            IconSpacing="4"
                                                            EntityId="{Binding Id}"
                                                            VerticalAlignment="Stretch" />

                                        <controls:NumericBlock Grid.Column="1"
                                                               Classes="OverlayRowMetricStrong"
                                                               Value="{Binding DamagePerSecond}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DpsTip}"
                                                               IsVisible="{Binding Columns.ShowDamagePerSecondColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0"
                                                               Suffix="/s" />

                                        <controls:NumericBlock Grid.Column="2"
                                                               Classes="OverlayRowMetric"
                                                               Value="{Binding Damage}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DamageTip}"
                                                               IsVisible="{Binding Columns.ShowDamageColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="3"
                                                               Classes="OverlayRowMetricStrong OverlayRowHealing"
                                                               Value="{Binding HealingPerSecond}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_HpsTip}"
                                                               IsVisible="{Binding Columns.ShowHealingPerSecondColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0"
                                                               Suffix="/s" />

                                        <controls:NumericBlock Grid.Column="4"
                                                               Classes="OverlayRowMetric OverlayRowHealing"
                                                               Value="{Binding Healing}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_HealingTip}"
                                                               IsVisible="{Binding Columns.ShowHealingColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="5"
                                                               Classes="OverlayRowMetric OverlayRowDamageTaken"
                                                               Value="{Binding DamageTaken}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_DamageTakenTip}"
                                                               IsVisible="{Binding Columns.ShowDamageTakenColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="6"
                                                               Classes="OverlayRowMetric OverlayRowUnhealedHealth"
                                                               Value="{Binding UnhealedHealthSeconds}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_UnhealedHealthTip}"
                                                               IsVisible="{Binding Columns.ShowUnhealedHealthColumn}"
                                                               VerticalAlignment="Center"
                                                               StableWidthScopeKey="{Binding Id}"
                                                               UseCompactNotation="{Binding Columns.UseCompactMainMetrics}"
                                                               Formatter="N0"
                                                               CompactThreshold="1000"
                                                               CompactSignificantDigits="3"
                                                               Margin="6,0,0,0" />

                                        <controls:NumericBlock Grid.Column="7"
                                                               Classes="OverlayRowMetric OverlayRowAggro"
                                                               Value="{Binding AggroShare}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_AggroTip}"
                                                               IsVisible="{Binding Columns.ShowAggroColumn}"
                                                               Formatter="P0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="8"
                                                               Classes="OverlayRowMetric OverlayRowStagger"
                                                               Value="{Binding StaggerShare}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_StaggerTip}"
                                                               IsVisible="{Binding Columns.ShowStaggerColumn}"
                                                               Formatter="P0"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />

                                        <controls:NumericBlock Grid.Column="9"
                                                               Classes="CombatantBossShareValue"
                                                               Value="{Binding BossShareRatio}"
                                                               ToolTip.Tip="{markups:Translate ColumnHeader_BossShareTip}"
                                                               IsVisible="{Binding Columns.ShowBossShareColumn}"
                                                               Formatter="P1"
                                                               Margin="6,0,0,0"
                                                               VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </controls:AnimatedItemsView.ItemTemplate>
                </controls:AnimatedItemsView>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Classes="MainHudForeground"
                        IsVisible="{Binding HasBossFights}">
                <Button Classes="BossSectionHeader"
                        Command="{Binding ToggleBossFightListCommand}">
                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="6">
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-down}"
                              IsVisible="{Binding IsBossFightListExpanded}" />
                        <Path Grid.Column="0"
                              Classes="Glyph GlyphSm"
                              Data="{StaticResource chevron-right}"
                              IsVisible="{Binding !IsBossFightListExpanded}" />
                        <TextBlock Grid.Column="1"
                                   Classes="BossSectionTitle"
                                   Text="{Binding BossFightListTitle}" />
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding BossFights}"
                              ItemTemplate="{StaticResource BossFightTemplate}"
                              IsVisible="{Binding IsBossFightListExpanded}"
                              Margin="8,0,0,3" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="5"
                Classes="MainHudFooterSeparator MainHudForeground"
                IsHitTestVisible="False" />

        <Border Grid.Row="5"
                Classes="MainHudFooter MainHudForeground">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6"
                  Margin="2,0">
                <Button Grid.Column="0"
                        Classes="BottomBarButton"
                        VerticalAlignment="Center"
                        Click="SettingsClicked"
                        ToolTip.Tip="{markups:Translate Settings_Title}">
                    <Path Classes="Glyph GlyphMd" Data="{StaticResource settings}" />
                </Button>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            Spacing="6"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{Binding Status}">
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding DriverIndicatorColor}"
                                ToolTip.Tip="{Binding DriverIndicatorToolTip}" />
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding GamePortIndicatorColor}"
                                ToolTip.Tip="{Binding GamePortIndicatorToolTip}" />
                        <Border Classes="BottomBarStatusIndicator"
                                Background="{Binding CaptureLockIndicatorColor}"
                                ToolTip.Tip="{Binding CaptureLockIndicatorToolTip}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{Binding LatencyToolTip}">
                        <Path Classes="Glyph GlyphMd BottomBarSignalGlyph"
                              Data="{StaticResource wifi}"
                              Stroke="{Binding LatencyIndicatorColor}" />
                        <controls:NumericBlock Classes="BottomBarMetric"
                                               Value="{Binding RoundTripTimeMilliseconds}"
                                               Suffix=" ms"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="3"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <controls:NumericBlock Classes="BottomBarMetric BottomBarTotalUnhealedHealth"
                                           IsVisible="{Binding CombatantColumns.ShowUnhealedHealthColumn}"
                                           Value="{Binding TotalUnhealedHealthSeconds}"
                                           Formatter="N0"
                                           UseCompactNotation="{Binding CombatantColumns.UseCompactMainMetrics}"
                                           CompactThreshold="1000"
                                           CompactSignificantDigits="3"
                                           StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                           Margin="0,0,5,0"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                    <controls:NumericBlock Classes="BottomBarMetric BottomBarTotalDps"
                                           IsVisible="{Binding CombatantColumns.ShowTotalDamagePerSecond}"
                                           Value="{Binding TotalFilteredDamagePerSecond}"
                                           Suffix="/s"
                                           Formatter="N0"
                                           UseCompactNotation="{Binding CombatantColumns.UseCompactMainMetrics}"
                                           CompactThreshold="1000"
                                           CompactSignificantDigits="3"
                                           StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                           Margin="0,0,5,0"
                                           HorizontalAlignment="Right"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center" />

                    <!-- The boss section's DPS check, folded or not: how much the group is ahead (green) or behind (red). -->
                    <TextBlock Classes="BossSectionGap"
                               Classes.behind="{Binding CurrentBossFight.IsBehind}"
                               IsVisible="{Binding CurrentBossFight.HasDpsCheck}"
                               Text="{Binding CurrentBossFight.DpsGapShortText}"
                               FontSize="{StaticResource AppFontSize.Body}"
                               Margin="0,0,5,0"
                               VerticalAlignment="Center" />

                    <controls:DurationBlock Classes="BottomBarMetric"
                                            Duration="{Binding EncounterDuration}"
                                            DisplayFormat="{Binding SettingsFlyout.EncounterTimeDisplayFormat}"
                                            StableWidthScopeKey="{Binding NumericStableWidthScopeKey}"
                                            Margin="0,0,3,0"
                                            VerticalAlignment="Center"
                                            ToolTip.Tip="{markups:Translate Metric_Duration}" />

                    <Border x:Name="OverlayPinSlot"
                            Width="26"
                            Height="26"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>

    <FlyoutBase.AttachedFlyout>
        <Flyout ShowMode="Transient"
                Closed="FlyoutClosed">
            <views:CombatantDetailsFlyoutView x:Name="CombatantDetailsFlyoutView"
                                              DataContext="{Binding CombatantDetails}" />
        </Flyout>
    </FlyoutBase.AttachedFlyout>
</Window>
