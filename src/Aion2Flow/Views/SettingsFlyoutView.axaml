<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hotkeys="clr-namespace:Cloris.Aion2Flow.Services.Hotkeys"
             xmlns:markups="clr-namespace:Cloris.Aion2Flow.Markups"
             xmlns:vm="clr-namespace:Cloris.Aion2Flow.ViewModels"
             x:Class="Cloris.Aion2Flow.Views.SettingsFlyoutView"
             x:DataType="vm:SettingsFlyoutViewModel">
    <!-- Styled by SettingsWindow's OverlayTheme; the setters below find its brushes and sizes there (DynamicResource). -->
    <UserControl.Styles>
        <!-- Every menu here lists its rows one below the other. -->
        <Style Selector="Menu.SettingsMenu">
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </Setter>
        </Style>

        <!-- The tabs, down the left. -->
        <Style Selector="StackPanel.SettingsTabs">
            <Setter Property="Background" Value="{DynamicResource OverlayBrush.DetailHudPanelSoft}" />
            <Setter Property="Spacing" Value="2" />
            <Setter Property="MinWidth" Value="150" />
        </Style>

        <Style Selector="StackPanel.SettingsTabs > ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="12,7,12,6" />
        </Style>

        <!-- A section's heading. -->
        <Style Selector="TextBlock.SettingsSection">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Caption}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="12,14,12,4" />
        </Style>

        <!-- A hint under a section's heading. -->
        <Style Selector="TextBlock.SettingsHint">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.TextSubtle}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Caption}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="12,0,12,6" />
        </Style>

        <!-- A scene's frames: Open, Folded, Closed, as narrow as their names, so that the click columns fit beside them.
             The meter's Closed keeps its room (its cross ends the overlay). -->
        <Style Selector="StackPanel.SceneStates > ToggleButton">
            <Setter Property="Padding" Value="5,2,5,3" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="StackPanel.SceneStates > ToggleButton.unavailable">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- The headings of a scene's click columns: as wide as their column, on as many lines as they need (a word never
             breaks). Korean and Chinese texts say where their lines break: those break between any two syllables, and the
             two headings' first lines ran into each other as one phrase. -->
        <Style Selector="TextBlock.SceneColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Caption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="WrapWithOverflow" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!-- A frame's settings while the frame is off: faded, and they take no clicks, but still explain themselves on hover
             (the group frame, the fight graphs and the Hidden Cubes are off at first). -->
        <Style Selector="StackPanel.FrameSettings:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
        </Style>

        <!-- The patch notes: the text muted, a "###" heading in gold, a group's line ("DPS meter") white; a bullet's lines
             beside its dot. -->
        <Style Selector="SelectableTextBlock.PatchNote">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.TextMuted}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Body}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style Selector="SelectableTextBlock.PatchNote.Heading">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.MainAccent}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Primary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>

        <Style Selector="SelectableTextBlock.PatchNote.Group">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.Text}" />
            <Setter Property="Margin" Value="0,6,0,4" />
        </Style>

        <Style Selector="TextBlock.PatchNoteDot">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.TextSubtle}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Body}" />
            <Setter Property="Margin" Value="2,0,6,0" />
        </Style>

        <!-- A credit's GitHub link under its text, in gold, in line with the text. -->
        <Style Selector="HyperlinkButton.CreditLink">
            <Setter Property="Foreground" Value="{DynamicResource OverlayBrush.MainAccent}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize.Body}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="12,0,12,10" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="Auto,*">
        <StackPanel x:Name="SettingsTabsPanel" Classes="SettingsTabs">
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsGeneralTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabGeneral}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsShortcutsTab, Mode=TwoWay}" Content="{markups:Translate Settings_Hotkeys}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsScenesTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabScenes}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsWorkflowsTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabWorkflows}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsVisualsTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabVisuals}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsAudioTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabAudio}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsMeterTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabMeter}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsGroupFrameTab, Mode=TwoWay}" Content="{markups:Translate Settings_GroupFrame}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsSkillMonitorTab, Mode=TwoWay}" Content="{markups:Translate Settings_SkillMonitor}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsFightGraphsTab, Mode=TwoWay}" Content="{markups:Translate Settings_FightGraphs}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsHiddenCubesTab, Mode=TwoWay}" Content="{markups:Translate HiddenCubes_Title}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsTwinLibraryTab, Mode=TwoWay}" Content="{markups:Translate TwinLibrary_Title}" />
            <ToggleButton Classes="DetailDirectionTab" IsChecked="{Binding IsSystemTab, Mode=TwoWay}" Content="{markups:Translate Settings_TabSystem}" />
        </StackPanel>

        <!-- 470 wide: a scene's frame rows with their two click columns fit in every language (German needs the most). -->
        <ScrollViewer x:Name="PageScroll"
                      Grid.Column="1"
                      Width="470"
                      Height="600"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Panel>
                <!-- General: language, when the overlay stays on top, times, the boss time limit, overhealing, how training
                     dummy pulls run, and the frames that take clicks without focus. -->
                <StackPanel IsVisible="{Binding IsGeneralTab}">
                    <Menu Classes="SettingsMenu">
                        <MenuItem x:Name="LanguageMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="LanguageMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_LanguageTip}" />
                        <MenuItem x:Name="TopmostMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="TopmostMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_TopmostTip}" />
                        <MenuItem x:Name="EncounterTimeDisplayFormatMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="EncounterTimeDisplayFormatMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_TimeDisplayFormatTip}" />
                        <MenuItem x:Name="BossTimeLimitMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="BossTimeLimitMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_BossTimeLimitTip}" />
                        <MenuItem x:Name="OverhealingMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="OverhealingMenuItemLoaded"
                                  Click="IncludeOverhealingMenuItemClicked"
                                  ToolTip.Tip="{markups:Translate Settings_MainMetricVisibility_OverhealingTip}" />
                    </Menu>

                    <TextBlock Classes="SettingsSection"
                               Text="{markups:Translate Settings_TrainingDummies}"
                               ToolTip.Tip="{markups:Translate Settings_TrainingDummiesTip}" />
                    <Menu x:Name="TrainingDummyMenu" Classes="SettingsMenu" />

                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_BossParticipation}" />
                    <Menu x:Name="GeneralLootMenu" Classes="SettingsMenu" />

                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Tutorial_Section}" />
                    <Button x:Name="StartTutorialButton"
                            Classes="SettingsUpdateButton"
                            Margin="12,2,12,10"
                            HorizontalAlignment="Left"
                            Click="StartTutorialClicked"
                            ToolTip.Tip="{markups:Translate Tutorial_StartTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource circle-help}" VerticalAlignment="Center" />
                            <TextBlock Text="{markups:Translate Tutorial_Start}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <TextBlock Classes="SettingsSection"
                               Text="{markups:Translate Settings_ClickableWithoutFocus}"
                               ToolTip.Tip="{markups:Translate Settings_ClickableWithoutFocusTip}" />
                    <Menu x:Name="ClickableMenu" Classes="SettingsMenu" />

                </StackPanel>

                <!-- Shortcuts: keys that work while the game has focus. -->
                <StackPanel IsVisible="{Binding IsShortcutsTab}">
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_Hotkeys}" />
                    <!-- How to set, cancel and clear a shortcut, one instruction a line. -->
                    <TextBlock Classes="SettingsHint" Text="{markups:Translate Settings_Hotkeys_Hint}" />
                    <Border Classes="SettingsHotkeyRow"
                            Tag="{x:Static hotkeys:GlobalHotkeyAction.MinimizeAllFrames}"
                            Focusable="True"
                            PointerPressed="HotkeyRowPressed"
                            KeyDown="HotkeyRowKeyDown"
                            LostFocus="HotkeyRowLostFocus"
                            ToolTip.Tip="{markups:Translate Settings_Hotkey_MinimizeAllTip}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Classes="SettingsRowLabel"
                                       Text="{markups:Translate Settings_Hotkey_MinimizeAll}" />
                            <TextBlock Grid.Column="1"
                                       Classes="SettingsRowValue"
                                       Text="{Binding MinimizeAllHotkeyDisplay}" />
                            <Button Grid.Column="2"
                                    Classes="FlyoutInlineButton"
                                    Command="{Binding ClearHotkeyCommand}"
                                    CommandParameter="{x:Static hotkeys:GlobalHotkeyAction.MinimizeAllFrames}"
                                    IsVisible="{Binding HasMinimizeAllHotkey}"
                                    ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Classes="SettingsHotkeyRow"
                            Tag="{x:Static hotkeys:GlobalHotkeyAction.BattleReset}"
                            Focusable="True"
                            PointerPressed="HotkeyRowPressed"
                            KeyDown="HotkeyRowKeyDown"
                            LostFocus="HotkeyRowLostFocus"
                            ToolTip.Tip="{markups:Translate Settings_Hotkey_BattleResetTip}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Classes="SettingsRowLabel"
                                       Text="{markups:Translate Settings_Hotkey_BattleReset}" />
                            <TextBlock Grid.Column="1"
                                       Classes="SettingsRowValue"
                                       Text="{Binding ResetHotkeyDisplay}" />
                            <Button Grid.Column="2"
                                    Classes="FlyoutInlineButton"
                                    Command="{Binding ClearHotkeyCommand}"
                                    CommandParameter="{x:Static hotkeys:GlobalHotkeyAction.BattleReset}"
                                    IsVisible="{Binding HasResetHotkey}"
                                    ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="SettingsHotkeyRow"
                            Tag="{x:Static hotkeys:GlobalHotkeyAction.CycleOverlayInteraction}"
                            Focusable="True"
                            PointerPressed="HotkeyRowPressed"
                            KeyDown="HotkeyRowKeyDown"
                            LostFocus="HotkeyRowLostFocus"
                            ToolTip.Tip="{markups:Translate Settings_Hotkey_MeterClickableTip}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Classes="SettingsRowLabel"
                                       Text="{markups:Translate Settings_Hotkey_MeterClickable}" />
                            <TextBlock Grid.Column="1"
                                       Classes="SettingsRowValue"
                                       Text="{Binding OverlayInteractionHotkeyDisplay}" />
                            <Button Grid.Column="2"
                                    Classes="FlyoutInlineButton"
                                    Command="{Binding ClearHotkeyCommand}"
                                    CommandParameter="{x:Static hotkeys:GlobalHotkeyAction.CycleOverlayInteraction}"
                                    IsVisible="{Binding HasOverlayInteractionHotkey}"
                                    ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Classes="SettingsHotkeyRow"
                            Tag="{x:Static hotkeys:GlobalHotkeyAction.SaveScene}"
                            Focusable="True"
                            PointerPressed="HotkeyRowPressed"
                            KeyDown="HotkeyRowKeyDown"
                            LostFocus="HotkeyRowLostFocus"
                            ToolTip.Tip="{markups:Translate Settings_Hotkey_SaveSceneTip}">
                        <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0"
                                       Classes="SettingsRowLabel"
                                       Text="{markups:Translate Settings_Hotkey_SaveScene}" />
                            <TextBlock Grid.Column="1"
                                       Classes="SettingsRowValue"
                                       Text="{Binding SaveSceneHotkeyDisplay}" />
                            <Button Grid.Column="2"
                                    Classes="FlyoutInlineButton"
                                    Command="{Binding ClearHotkeyCommand}"
                                    CommandParameter="{x:Static hotkeys:GlobalHotkeyAction.SaveScene}"
                                    IsVisible="{Binding HasSaveSceneHotkey}"
                                    ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Each scene's shortcut (the same as in its part of the Scenes tab). -->
                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneViewModel">
                                <Border Classes="SettingsHotkeyRow"
                                        Tag="{Binding HotkeyAction}"
                                        Focusable="True"
                                        PointerPressed="HotkeyRowPressed"
                                        KeyDown="HotkeyRowKeyDown"
                                        LostFocus="HotkeyRowLostFocus"
                                        ToolTip.Tip="{markups:Translate Settings_Hotkey_ApplySceneTip}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0"
                                                   Classes="SettingsRowLabel"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding ApplyHotkeyLabel}" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="SettingsRowValue"
                                                   Text="{Binding HotkeyDisplay}" />
                                        <Button Grid.Column="2"
                                                Classes="FlyoutInlineButton"
                                                Click="SceneHotkeyClearClicked"
                                                IsVisible="{Binding HasHotkey}"
                                                ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                            <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Classes="SettingsHotkeyError"
                               Text="{Binding HotkeyRegistrationErrorText}"
                               IsVisible="{Binding HasHotkeyRegistrationError}" />
                </StackPanel>

                <!-- Workflows: when something happens in game, a workflow that's on applies its scene. -->
                <StackPanel IsVisible="{Binding IsWorkflowsTab}">
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabWorkflows}" />
                    <TextBlock Classes="SettingsHint" Text="{markups:Translate Workflows_Hint}" />
                    <Button Classes="SettingsUpdateButton"
                            Margin="12,2,12,10"
                            HorizontalAlignment="Left"
                            IsEnabled="{Binding HasScenes}"
                            Click="AddWorkflowClicked"
                            ToolTip.Tip="{markups:Translate Workflows_AddTip}"
                            ToolTip.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource plus}" VerticalAlignment="Center" />
                            <TextBlock Text="{markups:Translate Workflows_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="SettingsHint"
                               Text="{markups:Translate Workflows_NeedScene}"
                               IsVisible="{Binding !HasScenes}" />

                    <ItemsControl ItemsSource="{Binding Workflows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkflowViewModel">
                                <Border Classes="SettingsUpdatePanel" Margin="0,0,0,10">
                                    <!-- When [trigger], apply [scene]; on or off; delete (asks once). -->
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Classes="SettingsRowLabel" Text="{markups:Translate Workflows_When}" />
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding Triggers}"
                                                  SelectedIndex="{Binding TriggerIndex, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  FontSize="12"
                                                  ToolTip.Tip="{markups:Translate Workflows_WhenTip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:WorkflowTriggerOption">
                                                    <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Tip}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                  Content="{markups:Translate Workflows_Active}"
                                                  ToolTip.Tip="{markups:Translate Workflows_ActiveTip}" />
                                        <Button Grid.Column="3"
                                                Classes="FlyoutInlineButton"
                                                Width="NaN"
                                                MinWidth="18"
                                                Click="DeleteWorkflowClicked"
                                                ToolTip.Tip="{markups:Translate Workflows_DeleteTip}">
                                            <Panel>
                                                <Path Classes="Glyph GlyphSm" Data="{StaticResource trash}" IsVisible="{Binding !IsDeleteArmed}" />
                                                <TextBlock Text="{markups:Translate TwinLibrary_Delete}" Foreground="#F07C82" FontWeight="SemiBold" IsVisible="{Binding IsDeleteArmed}" />
                                            </Panel>
                                        </Button>
                                        <TextBlock Grid.Row="1" Classes="SettingsRowLabel" Text="{markups:Translate Workflows_Apply}" />
                                        <ComboBox Grid.Row="1"
                                                  Grid.Column="1"
                                                  ItemsSource="{Binding Scenes}"
                                                  SelectedItem="{Binding Scene, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  FontSize="12"
                                                  ToolTip.Tip="{markups:Translate Workflows_ApplyTip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SceneViewModel">
                                                    <TextBlock Text="{Binding Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Scenes: saved layouts of the frames, each frame open, folded or closed, where it was and where it takes
                     clicks. A scene's places change only when it's overwritten, its positions alone or all of it (or it's
                     saved again under its name); its name, its shortcut, and its frames' states and clicks can change here. -->
                <StackPanel IsVisible="{Binding IsScenesTab}">
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabScenes}" />
                    <TextBlock Classes="SettingsHint" Text="{markups:Translate Scenes_Hint}" />
                    <Button Classes="SettingsUpdateButton"
                            Margin="12,2,12,10"
                            HorizontalAlignment="Left"
                            Click="AddSceneClicked"
                            ToolTip.Tip="{markups:Translate Scenes_AddTip}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="Glyph GlyphSm" Data="{StaticResource plus}" VerticalAlignment="Center" />
                            <TextBlock Text="{markups:Translate Scenes_Add}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="SettingsHint"
                               Text="{markups:Translate Scenes_Empty}"
                               IsVisible="{Binding !HasScenes}" />

                    <ItemsControl ItemsSource="{Binding Scenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SceneViewModel">
                                <Border Classes="SettingsUpdatePanel" Margin="0,0,0,10">
                                    <StackPanel Spacing="4">
                                        <!-- Its name: apply now, overwrite (asks once), overwrite its positions only (asks
                                             once), rename, delete (asks once). -->
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="2">
                                            <TextBlock Classes="SettingsRowLabel"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Name}" />
                                            <Button Grid.Column="1"
                                                    Classes="SettingsUpdateButton"
                                                    Click="ApplySceneClicked"
                                                    Content="{markups:Translate Scenes_Apply}"
                                                    ToolTip.Tip="{markups:Translate Scenes_ApplyTip}" />
                                            <!-- 6 apart from Apply now: at the grid's 2 their borders run together. -->
                                            <Button Grid.Column="2"
                                                    Classes="SettingsUpdateButton"
                                                    Margin="4,0,0,0"
                                                    Click="OverwriteSceneClicked"
                                                    ToolTip.Tip="{markups:Translate Scenes_OverwriteTip}">
                                                <Panel>
                                                    <TextBlock Text="{markups:Translate Scenes_Overwrite}" IsVisible="{Binding !IsOverwriteArmed}" />
                                                    <TextBlock Text="{markups:Translate Scenes_OverwriteAsk}" Foreground="#F07C82" IsVisible="{Binding IsOverwriteArmed}" />
                                                </Panel>
                                            </Button>
                                            <!-- Overwrite's look with an icon: a word there leaves the name too little room
                                                 in German. -->
                                            <Button Grid.Column="3"
                                                    Classes="SettingsUpdateButton"
                                                    Margin="4,0,0,0"
                                                    Click="OverwriteScenePositionsClicked"
                                                    ToolTip.Tip="{markups:Translate Scenes_PositionsTip}">
                                                <Panel>
                                                    <Path Classes="Glyph GlyphSm" Data="{StaticResource move}" IsVisible="{Binding !IsPositionsArmed}" />
                                                    <TextBlock Text="{markups:Translate Scenes_PositionsAsk}" Foreground="#F07C82" IsVisible="{Binding IsPositionsArmed}" />
                                                </Panel>
                                            </Button>
                                            <Button Grid.Column="4"
                                                    Classes="FlyoutInlineButton"
                                                    Click="RenameSceneClicked"
                                                    ToolTip.Tip="{markups:Translate Scenes_RenameTip}">
                                                <Path Classes="Glyph GlyphSm" Data="{StaticResource pencil}" />
                                            </Button>
                                            <Button Grid.Column="5"
                                                    Classes="FlyoutInlineButton"
                                                    Width="NaN"
                                                    MinWidth="18"
                                                    Click="DeleteSceneClicked"
                                                    ToolTip.Tip="{markups:Translate Scenes_DeleteTip}">
                                                <Panel>
                                                    <Path Classes="Glyph GlyphSm" Data="{StaticResource trash}" IsVisible="{Binding !IsDeleteArmed}" />
                                                    <TextBlock Text="{markups:Translate TwinLibrary_Delete}" Foreground="#F07C82" FontWeight="SemiBold" IsVisible="{Binding IsDeleteArmed}" />
                                                </Panel>
                                            </Button>
                                        </Grid>

                                        <!-- Its shortcut (also under Shortcuts). -->
                                        <Border Classes="SettingsHotkeyRow"
                                                Tag="{Binding HotkeyAction}"
                                                Focusable="True"
                                                PointerPressed="HotkeyRowPressed"
                                                KeyDown="HotkeyRowKeyDown"
                                                LostFocus="HotkeyRowLostFocus"
                                                ToolTip.Tip="{markups:Translate Scenes_ShortcutTip}">
                                            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0"
                                                           Classes="SettingsRowLabel"
                                                           Text="{markups:Translate Scenes_Shortcut}" />
                                                <TextBlock Grid.Column="1"
                                                           Classes="SettingsRowValue"
                                                           Text="{Binding HotkeyDisplay}" />
                                                <Button Grid.Column="2"
                                                        Classes="FlyoutInlineButton"
                                                        Click="SceneHotkeyClearClicked"
                                                        IsVisible="{Binding HasHotkey}"
                                                        ToolTip.Tip="{markups:Translate Settings_Hotkey_Clear}">
                                                    <Path Classes="Glyph GlyphSm" Data="{StaticResource x}" />
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Each frame: what the scene does with it, and whether it makes it clickable without
                                             focus and its title line always clickable (a dash: it leaves that as it is). The
                                             headings and the check boxes share their columns' fixed widths. -->
                                        <Grid ColumnDefinitions="*,64,64" Margin="0,4,0,0">
                                            <TextBlock Grid.Column="1"
                                                       Classes="SceneColumnHeader"
                                                       Text="{markups:Translate Scenes_ClickableHeader}"
                                                       ToolTip.Tip="{markups:Translate Settings_ClickableWithoutFocusTip}" />
                                            <TextBlock Grid.Column="2"
                                                       Classes="SceneColumnHeader"
                                                       Text="{markups:Translate Scenes_TitleClickableHeader}"
                                                       ToolTip.Tip="{markups:Translate Settings_TitleClickableTip}" />
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Frames}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SceneFrameViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,64,64" Margin="0,1">
                                                        <TextBlock Classes="SettingsRowValue"
                                                                   Margin="0"
                                                                   HorizontalAlignment="Left"
                                                                   TextAlignment="Left"
                                                                   Text="{Binding Label}" />
                                                        <StackPanel Grid.Column="1"
                                                                    Classes="DetailDirectionTabs SceneStates"
                                                                    Orientation="Horizontal"
                                                                    Spacing="2">
                                                            <ToggleButton Classes="DetailDirectionTab"
                                                                          IsChecked="{Binding IsOpen, Mode=TwoWay}"
                                                                          Content="{markups:Translate Scenes_Open}"
                                                                          ToolTip.Tip="{markups:Translate Scenes_StateTip}" />
                                                            <ToggleButton Classes="DetailDirectionTab"
                                                                          IsChecked="{Binding IsFolded, Mode=TwoWay}"
                                                                          Content="{markups:Translate Scenes_Folded}"
                                                                          ToolTip.Tip="{markups:Translate Scenes_StateTip}" />
                                                            <ToggleButton Classes="DetailDirectionTab"
                                                                          Classes.unavailable="{Binding !CanClose}"
                                                                          IsChecked="{Binding IsClosed, Mode=TwoWay}"
                                                                          Content="{markups:Translate Scenes_Closed}"
                                                                          ToolTip.Tip="{markups:Translate Scenes_StateTip}" />
                                                        </StackPanel>
                                                        <CheckBox Grid.Column="2"
                                                                  Classes="CounterpartRowCheckBox"
                                                                  HorizontalAlignment="Center"
                                                                  IsThreeState="True"
                                                                  IsChecked="{Binding ClickableWithoutFocus, Mode=TwoWay}"
                                                                  ToolTip.Tip="{markups:Translate Scenes_SettingTip}" />
                                                        <CheckBox Grid.Column="3"
                                                                  Classes="CounterpartRowCheckBox"
                                                                  HorizontalAlignment="Center"
                                                                  IsThreeState="True"
                                                                  IsChecked="{Binding TitleClickable, Mode=TwoWay}"
                                                                  ToolTip.Tip="{markups:Translate Scenes_SettingTip}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <!-- Visuals: every frame's size and opacity, whether it's clickable without focus and whether its title line
                     always is, also in each frame's own tab. -->
                <StackPanel IsVisible="{Binding IsVisualsTab}">
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabMeter}" />
                    <Menu x:Name="VisualsMeterMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_FooterGraphs}" />
                    <Menu x:Name="VisualsFooterGraphsMenu" Classes="SettingsMenu" />
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding GroupFrameEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_GroupFrame}" />
                        <Menu x:Name="VisualsGroupFrameMenu" Classes="SettingsMenu" />
                    </StackPanel>
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding SkillMonitorEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_SkillMonitor}" />
                        <Menu x:Name="VisualsSkillMonitorMenu" Classes="SettingsMenu" />
                    </StackPanel>
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding FightGraphsEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_FightGraphs}" />
                        <Menu x:Name="VisualsFightGraphsMenu" Classes="SettingsMenu" />
                    </StackPanel>
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding HiddenCubesEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate HiddenCubes_Title}" />
                        <Menu x:Name="VisualsHiddenCubesMenu" Classes="SettingsMenu" />
                    </StackPanel>
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate TwinLibrary_Title}" />
                    <Menu x:Name="VisualsTwinLibraryMenu" Classes="SettingsMenu" />
                </StackPanel>

                <!-- Audio: everything that makes a sound (the group frame's, so they fade with it). -->
                <StackPanel IsVisible="{Binding IsAudioTab}">
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding GroupFrameEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_GroupFrame}" />
                        <Menu x:Name="AudioMenu" Classes="SettingsMenu" />
                    </StackPanel>
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding HiddenCubesEnabled}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate HiddenCubes_Title}" />
                        <Menu x:Name="AudioHiddenCubesMenu" Classes="SettingsMenu" />
                    </StackPanel>
                </StackPanel>

                <!-- The DPS meter. -->
                <StackPanel IsVisible="{Binding IsMeterTab}">
                    <Menu Classes="SettingsMenu">
                        <MenuItem x:Name="VisibleRowsMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="VisibleRowsMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_VisibleRowsTip}" />
                        <MenuItem x:Name="CombatantStatisticsScopeMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="CombatantStatisticsScopeMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_CombatantStatisticsScopeTip}" />
                        <MenuItem x:Name="CombatantSortMetricMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="CombatantSortMetricMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_CombatantSortMetricTip}" />
                    </Menu>
                    <Menu x:Name="MeterSortMenu" Classes="SettingsMenu" />
                    <Menu Classes="SettingsMenu">
                        <MenuItem x:Name="MainMetricVisibilityMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="MainMetricVisibilityMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_MainMetricVisibilityTip}" />
                        <MenuItem x:Name="ColumnHeadersMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="ColumnHeadersMenuItemLoaded"
                                  Click="ShowColumnHeadersMenuItemClicked"
                                  ToolTip.Tip="{markups:Translate Settings_MainMetricVisibility_ColumnHeadersTip}" />
                        <MenuItem x:Name="SceneKindMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="SceneKindMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_SceneKindTip}" />
                        <MenuItem x:Name="CompactMainMetricsMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="CompactMainMetricsMenuItemLoaded"
                                  Click="CompactMainMetricsMenuItemClicked"
                                  ToolTip.Tip="{markups:Translate Settings_MainMetricsCompactTip}" />
                        <MenuItem x:Name="FocusStatusBarMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="FocusStatusBarMenuItemLoaded"
                                  Click="FocusStatusBarMenuItemClicked"
                                  ToolTip.Tip="{markups:Translate Settings_FocusStatusBarTip}" />
                        <MenuItem x:Name="PlayerNameSettingsMenuItem"
                                  Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                  Loaded="PlayerNameSettingsMenuItemLoaded"
                                  ToolTip.Tip="{markups:Translate Settings_PlayerNameSettingsTip}" />
                    </Menu>
                    <Menu x:Name="MeterBossSumMenu" Classes="SettingsMenu" />
                    <Menu x:Name="MeterClickableMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate PingGraph_Ping}" />
                    <Menu x:Name="MeterPingMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_FrameRate}" />
                    <Menu x:Name="MeterFrameRateMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_FooterGraphs}" />
                    <Menu x:Name="MeterFooterGraphsMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_Odyle}" />
                    <Menu x:Name="MeterOdyleMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                    <Menu x:Name="MeterVisualsMenu" Classes="SettingsMenu" />
                </StackPanel>

                <!-- Each frame: on or off at the top, the rest fades while it's off. -->
                <StackPanel IsVisible="{Binding IsGroupFrameTab}">
                    <Menu x:Name="GroupFrameEnableMenu" Classes="SettingsMenu" />
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding GroupFrameEnabled}">
                        <Menu x:Name="GroupFrameMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_GroupFrame_Auras}" />
                        <Menu x:Name="GroupFrameAuraMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_BossParticipation}" />
                        <Menu x:Name="GroupFrameLootMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_GroupFrame_Alert}" />
                        <Menu x:Name="GroupFrameAlertMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                        <Menu x:Name="GroupFrameVisualsMenu" Classes="SettingsMenu" />
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsSkillMonitorTab}">
                    <Menu x:Name="SkillMonitorEnableMenu" Classes="SettingsMenu" />
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding SkillMonitorEnabled}">
                        <Menu x:Name="SkillMonitorMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                        <Menu x:Name="SkillMonitorVisualsMenu" Classes="SettingsMenu" />
                        <ContentControl x:Name="SkillMonitorSettingsHost" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsFightGraphsTab}">
                    <Menu x:Name="FightGraphsEnableMenu" Classes="SettingsMenu" />
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding FightGraphsEnabled}">
                        <Menu x:Name="FightGraphsMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                        <Menu x:Name="FightGraphsVisualsMenu" Classes="SettingsMenu" />
                    </StackPanel>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsHiddenCubesTab}">
                    <Menu x:Name="HiddenCubesEnableMenu" Classes="SettingsMenu" />
                    <StackPanel Classes="FrameSettings" IsEnabled="{Binding HiddenCubesEnabled}">
                        <Menu x:Name="HiddenCubesMenu" Classes="SettingsMenu" />
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                        <Menu x:Name="HiddenCubesVisualsMenu" Classes="SettingsMenu" />
                    </StackPanel>
                </StackPanel>
                <!-- The library opens with lookups off too, so nothing here fades. The lookups come first, the pause between
                     the website's calls last, with its warning in red right under it, always there to be read before the
                     pause goes down. -->
                <StackPanel IsVisible="{Binding IsTwinLibraryTab}">
                    <Menu x:Name="TwinLookupMenu" Classes="SettingsMenu" />
                    <TextBlock x:Name="TwinLookupPauseWarning"
                               Classes="SettingsHint"
                               Foreground="#F07C82"
                               Text="{markups:Translate Settings_TwinLookupPauseWarning}" />
                    <Menu x:Name="TwinLibraryMenu" Classes="SettingsMenu" />
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_TabVisuals}" />
                    <Menu x:Name="TwinLibraryVisualsMenu" Classes="SettingsMenu" />
                </StackPanel>

                <!-- System: the packet recording, the version, the updates, the credits and the patch notes. -->
                <StackPanel IsVisible="{Binding IsSystemTab}">
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_Debugging}" />
                    <Menu x:Name="DebuggingMenu" Classes="SettingsMenu" />

                    <!-- A build Velopack didn't install (a local build) gets no updates, just its version. -->
                    <Border Classes="SettingsUpdatePanel"
                            IsVisible="{Binding !IsUpdateSectionVisible}">
                        <TextBlock Classes="SettingsUpdateVersion"
                                   Text="{Binding CurrentVersionText}" />
                    </Border>

                    <StackPanel IsVisible="{Binding IsUpdateSectionVisible}">
                        <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_Updates}" />
                        <Menu Classes="SettingsMenu">
                            <MenuItem x:Name="UpdateAutomaticallyMenuItem"
                                      Classes="FlyoutMenuItem FlyoutPanelRow SettingsRowItem"
                                      Loaded="UpdateAutomaticallyMenuItemLoaded"
                                      Click="UpdateAutomaticallyMenuItemClicked"
                                      ToolTip.Tip="{markups:Translate Settings_Update_AutomaticallyTip}" />
                        </Menu>
                        <Border Classes="SettingsUpdatePanel">
                            <Grid RowDefinitions="Auto,Auto"
                                  RowSpacing="6">
                                <Grid Grid.Row="0"
                                      ColumnDefinitions="Auto,*"
                                      ColumnSpacing="8">
                                    <TextBlock Grid.Column="0"
                                               Classes="SettingsUpdateVersion"
                                               Text="{Binding CurrentVersionText}"
                                               IsVisible="{Binding CurrentVersionText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                                    <TextBlock Grid.Column="1"
                                               Classes="SettingsUpdateStatus"
                                               Text="{Binding UpdateStatusText}"
                                               HorizontalAlignment="Right"
                                               TextAlignment="Right"
                                               IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </Grid>

                                <Grid Grid.Row="1"
                                      ColumnDefinitions="*,Auto"
                                      ColumnSpacing="6">
                                    <ProgressBar Grid.Column="0"
                                                 Classes="SettingsUpdateProgress"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding DownloadProgress}"
                                                 IsIndeterminate="{Binding IsCheckingUpdate}"
                                                 IsVisible="{Binding IsBusyOrChecking}" />

                                    <Button Grid.Column="1"
                                            Classes="SettingsUpdateButton"
                                            Command="{Binding UpdateNowCommand}"
                                            IsVisible="{Binding CanUpdateNow}"
                                            Content="{markups:Translate Settings_Update_Now}"
                                            ToolTip.Tip="{markups:Translate Settings_Update_NowTip}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Who made what, each with its GitHub page (CreditLinkClicked opens it). -->
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_Credits}" />
                    <TextBlock Classes="SettingsHint" Text="{markups:Translate Settings_CreditsAion2Flow}" />
                    <HyperlinkButton Classes="CreditLink"
                                     Content="https://github.com/cloris-chan/Aion2Flow"
                                     Click="CreditLinkClicked"
                                     ToolTip.Tip="{markups:Translate Settings_CreditsLinkTip}" />
                    <TextBlock Classes="SettingsHint" Text="{markups:Translate Settings_CreditsAion2Heal}" />
                    <HyperlinkButton Classes="CreditLink"
                                     Content="https://github.com/rassau/AION2HealerOverlay"
                                     Click="CreditLinkClicked"
                                     ToolTip.Tip="{markups:Translate Settings_CreditsLinkTip}" />

                    <!-- The patch notes of the version picked (English only), first in short, then in detail: in the page's
                         own scroll, the lines made in code (ShowPatchNotes). The settings window drags by its title only, so
                         the box opens from a click anywhere on it. Not focusable: a focused ComboBox turns the mouse wheel
                         into the next version, and this one sits in the page's scroll path (a click still opens it; no
                         Tab-key stop). -->
                    <TextBlock Classes="SettingsSection" Text="{markups:Translate Settings_PatchNotes}" />
                    <TextBlock x:Name="PatchNotesHint"
                               Classes="SettingsHint"
                               Text="{markups:Translate Settings_PatchNotesEnglish}"
                               IsVisible="{Binding IsPatchNotesHintVisible}" />
                    <ComboBox x:Name="PatchNotesBox"
                              Focusable="False"
                              Margin="12,2,12,6"
                              HorizontalAlignment="Stretch"
                              FontSize="12"
                              ItemsSource="{Binding PatchNotesVersions}"
                              SelectedItem="{Binding SelectedPatchNotes, Mode=TwoWay}"
                              ToolTip.Tip="{markups:Translate Settings_PatchNotesTip}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:PatchNotesOption">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="{markups:Translate Settings_PatchNotesInstalled}" IsVisible="{Binding IsInstalled}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel x:Name="PatchNotesPanel" Margin="12,0,12,12" />
                </StackPanel>
            </Panel>
        </ScrollViewer>
    </Grid>
</UserControl>
